<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<style>
  /* ============================================
     MODERN THEME - BLACK, WHITE, LIGHT ORANGE
     ============================================ */
  :root{
    --shop-ai-primary: #FF9D5C;
    --shop-ai-primary-dark: #FF8534;
    --shop-ai-gradient: linear-gradient(135deg, #FF9D5C 0%, #FF8534 100%);
    --shop-ai-bg: #ffffff;
    --shop-ai-text: #1a1a1a;
    --shop-ai-text-light: #666666;
    --shop-ai-border: rgba(0,0,0,0.08);
    --shop-ai-glass: rgba(255,255,255,0.8);
    --shop-ai-shadow: 0 20px 60px rgba(0,0,0,0.12);
    --shop-ai-shadow-sm: 0 4px 12px rgba(0,0,0,0.06);
    --shop-ai-shadow-xs: 0 1px 3px rgba(0,0,0,0.04);
    --shop-ai-radius: 24px;
    --shop-ai-font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .shop-ai-reset *{
    box-sizing: border-box;
    font-family: var(--shop-ai-font);
    -webkit-font-smoothing: antialiased;
  }

  /* Override Shopify global *:focus-visible outline/box-shadow conflict */
  .shop-ai-reset *:focus-visible{
    outline: none !important;
    box-shadow: none !important;
  }

  /* ============================================
     FLOATING LAUNCHER — HIDDEN (moved to header)
     ============================================ */
  .shop-ai-floating-group{
    display: none !important;
  }

  /* ============================================
     HEADER "ASK AI" BUTTON — injected via JS
     ============================================ */
  .shop-ai-header-trigger{
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--shop-ai-gradient);
    color: #fff !important;
    font-size: 13px;
    font-weight: 600;
    font-family: var(--shop-ai-font);
    border: none;
    cursor: pointer;
    white-space: nowrap;
    line-height: 1;
    letter-spacing: 0.01em;
    transition: transform 0.2s cubic-bezier(0.16,1,0.3,1), box-shadow 0.2s ease, opacity 0.2s ease;
    box-shadow: 0 2px 8px rgba(255,133,52,0.25);
    vertical-align: middle;
    text-decoration: none !important;
    -webkit-font-smoothing: antialiased;
  }

  .shop-ai-header-trigger:hover{
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(255,133,52,0.35);
  }

  .shop-ai-header-trigger:active{
    transform: scale(0.96);
    transition-duration: 0.1s;
  }

  .shop-ai-header-trigger svg{
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Wrapper so it sits nicely in Dawn header__icons */
  .shop-ai-header-trigger-wrap{
    display: inline-flex;
    align-items: center;
    margin-left: 4px;
  }

  /* ---- Mobile: smaller pill ---- */
  @media (max-width: 749px){
    .shop-ai-header-trigger{
      padding: 7px 12px;
      font-size: 12px;
      gap: 4px;
    }
    .shop-ai-header-trigger svg{
      width: 14px;
      height: 14px;
    }
    /* If header is too cramped, hide the label text on very small screens */
    .shop-ai-header-trigger .shop-ai-trigger-label{
      display: inline;
    }
  }
  @media (max-width: 389px){
    .shop-ai-header-trigger{
      padding: 6px 10px;
      font-size: 0; /* hide text, icon only */
      gap: 0;
    }
    .shop-ai-header-trigger svg{
      width: 18px;
      height: 18px;
    }
    .shop-ai-header-trigger .shop-ai-trigger-label{
      display: none;
    }
  }

  /* ============================================
     BACKDROP & MODAL
     ============================================ */
  .shop-ai-backdrop{
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(6px);
    z-index: 999998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  body.shop-ai-open .shop-ai-backdrop{
    opacity: 1;
    visibility: visible;
  }

  .shop-ai-modal{
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -48%) scale(0.96);
    width: 92%;
    max-width: 720px;
    height: 75vh;
    max-height: 90vh;
    background: rgba(255,255,255,0.94);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-radius: var(--shop-ai-radius);
    box-shadow: 0 20px 60px rgba(0,0,0,0.1), 0 0 0 1px rgba(255,255,255,0.2) inset;
    z-index: 999999;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid rgba(255,255,255,0.35);
  }

  body.shop-ai-open .shop-ai-modal{
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  /* Fallback: .active class on elements directly */
  .shop-ai-modal.active{
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }
  .shop-ai-backdrop.active{
    opacity: 1;
    visibility: visible;
  }

  /* ============================================
     HEADER - TRANSLUCENT TEXT ON BORDER
     ============================================ */
  .shop-ai-header{
    position: relative;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100px;
    border-bottom: 1px solid transparent;
    background: linear-gradient(180deg, rgba(255,157,92,0.03) 0%, rgba(255,255,255,0) 100%);
  }

  .shop-ai-header::before{
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(255,157,92,0.3) 20%,
      rgba(255,133,52,0.5) 50%,
      rgba(255,157,92,0.3) 80%,
      transparent 100%);
    opacity: 0.8;
  }

  .shop-ai-header h3{
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    background: linear-gradient(135deg, #FF9D5C 0%, #FF8534 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
    z-index: 2;
    letter-spacing: -0.5px;
  }

  /* Header actions - minimalist 3-dot menu */
  .shop-ai-header-actions{
    position: absolute;
    right: 20px;
    top: 20px;
    display: flex;
    gap: 8px;
    z-index: 10;
  }

  .shop-ai-icon-btn{
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.04);
    border: 1px solid var(--shop-ai-border);
    color: var(--shop-ai-text);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .shop-ai-icon-btn:hover{
    background: rgba(255,157,92,0.1);
    transform: translateY(-1px);
  }

  .shop-ai-icon-btn:active{
    transform: scale(0.94);
    transition-duration: 0.1s;
  }

  .shop-ai-menu-btn{
    position: relative;
  }

  .shop-ai-menu-btn svg{
    width: 4px;
    height: 4px;
  }

  /* 3-dot icon */
  .shop-ai-3dot-icon{
    display: flex;
    flex-direction: column;
    gap: 3px;
    align-items: center;
  }

  .shop-ai-3dot-icon span{
    width: 4px;
    height: 4px;
    background: var(--shop-ai-text);
    border-radius: 50%;
    opacity: 0.6;
  }

  /* Dropdown menu */
  .shop-ai-menu-dropdown{
    position: absolute;
    top: 48px;
    right: 0;
    background: white;
    border: 1px solid var(--shop-ai-border);
    border-radius: 12px;
    box-shadow: var(--shop-ai-shadow);
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
    z-index: 1000;
  }

  .shop-ai-menu-dropdown.active{
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .shop-ai-menu-item{
    width: 100%;
    padding: 14px 18px;
    border: none;
    background: transparent;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
    color: var(--shop-ai-text);
    cursor: pointer;
    transition: background 0.15s ease;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .shop-ai-menu-item:hover{
    background: rgba(255,157,92,0.08);
  }

  .shop-ai-menu-item.danger{
    color: #ef4444;
  }

  /* ============================================
     MESSAGES AREA
     ============================================ */
  .shop-ai-messages{
    flex: 1;
    overflow-y: auto;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: transparent;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: rgba(0,0,0,0.1) transparent;
  }

  .shop-ai-messages::-webkit-scrollbar{
    width: 4px;
  }
  .shop-ai-messages::-webkit-scrollbar-track{
    background: transparent;
  }
  .shop-ai-messages::-webkit-scrollbar-thumb{
    background: rgba(0,0,0,0.1);
    border-radius: 4px;
  }
  .shop-ai-messages::-webkit-scrollbar-thumb:hover{
    background: rgba(0,0,0,0.2);
  }

  .shop-ai-message{
    display: flex;
    flex-direction: column;
    animation: messageSlide 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes messageSlide{
    from{
      opacity: 0;
      transform: translateY(8px);
    }
    to{
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* User message - right aligned bubble, readable text */
  .shop-ai-message.user{
    align-self: flex-end;
    max-width: 75%;
  }

  .shop-ai-message.user .shop-ai-bubble{
    padding: 10px 14px;
    background: var(--shop-ai-gradient);
    border-radius: 16px;
    border-bottom-right-radius: 4px;
    border: none;
    box-shadow: var(--shop-ai-shadow-sm);
    color: #ffffff;
    font-size: 15px;
    font-weight: 500;
    text-align: right;
  }

  /* Assistant message - light bubble */
  .shop-ai-message.assistant{
    align-self: flex-start;
    max-width: 85%;
  }

  .shop-ai-message.assistant .shop-ai-bubble{
    padding: 16px 18px;
    background: rgba(0,0,0,0.02);
    border-radius: 18px;
    border-top-left-radius: 4px;
    border: none;
    box-shadow: var(--shop-ai-shadow-xs);
    color: var(--shop-ai-text);
    font-size: 15px;
    line-height: 1.6;
  }

  /* Clean markdown formatting */
  .shop-ai-bubble p{
    margin: 0 0 12px 0;
  }

  .shop-ai-bubble p:last-child{
    margin-bottom: 0;
  }

  .shop-ai-bubble strong{
    font-weight: 600;
    color: var(--shop-ai-text);
  }

  .shop-ai-bubble a{
    color: var(--shop-ai-primary);
    text-decoration: none;
  }

  /* ============================================
     SUGGESTIONS - INDUSTRIAL PRODUCTS
     ============================================ */
  .shop-ai-suggestions{
    display: block;
    margin-top: auto;
    opacity: 0;
    animation: fadeIn 0.5s ease forwards;
    animation-delay: 0.2s;
  }

  @keyframes fadeIn{
    to{
      opacity: 1;
    }
  }

  .shop-ai-suggestions.visible{
    opacity: 1;
  }

  .shop-ai-sugg-title{
    font-size: 12px;
    text-transform: uppercase;
    color: var(--shop-ai-text-light);
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 14px;
  }

  .shop-ai-sugg-list{
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .shop-ai-sugg-item{
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 12px;
    background: white;
    border: 1px solid var(--shop-ai-border);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    font-size: 14px;
    font-weight: 500;
    color: var(--shop-ai-text);
  }

  .shop-ai-sugg-item svg{
    width: 18px;
    height: 18px;
    color: var(--shop-ai-primary);
    flex-shrink: 0;
  }

  .shop-ai-sugg-item:hover{
    transform: translateX(6px);
    border-color: var(--shop-ai-primary);
    box-shadow: var(--shop-ai-shadow-sm);
  }

  /* ============================================
     PRODUCT DISPLAY - HORIZONTAL CAROUSEL
     ============================================ */
  @keyframes fadeInUp{
    from{ opacity: 0; transform: translateY(12px); }
    to{ opacity: 1; transform: translateY(0); }
  }

  .shop-ai-product-grid{
    display: flex;
    flex-wrap: nowrap;
    gap: 12px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 8px 2px 12px;
    scrollbar-width: none;
    animation: fadeInUp 0.35s ease;
    min-width: 0;
  }

  .shop-ai-product-grid::-webkit-scrollbar{
    display: none;
  }

  .shop-ai-product-card{
    flex: 0 0 148px;
    min-width: 0;
    scroll-snap-align: start;
    background: white;
    border: 1px solid var(--shop-ai-border);
    border-radius: 14px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
  }

  .shop-ai-product-card:hover{
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    border-color: var(--shop-ai-primary);
  }

  .shop-ai-product-card:active{
    transform: translateY(-1px) scale(0.98);
    transition-duration: 0.1s;
  }

  .shop-ai-product-image{
    width: 100%;
    height: 148px;
    object-fit: cover;
    background: #f5f5f5;
    display: block;
    flex-shrink: 0;
  }

  .shop-ai-product-info{
    padding: 10px;
    min-width: 0;
    overflow: hidden;
  }

  .shop-ai-product-title{
    font-size: 13px;
    font-weight: 600;
    color: var(--shop-ai-text);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .shop-ai-product-price{
    font-size: 13px;
    font-weight: 600;
    color: var(--shop-ai-primary);
    margin: 4px 0 0;
  }

  /* ============================================
     PRODUCT DETAIL POPUP
     ============================================ */
  .shop-ai-product-modal-overlay{
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(8px);
    z-index: 2000000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .shop-ai-product-modal-overlay.active{
    opacity: 1;
    visibility: visible;
  }

  .shop-ai-product-modal{
    width: 100%;
    max-width: 580px;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    border-radius: 24px;
    box-shadow: 0 24px 60px rgba(0,0,0,0.14), 0 0 0 1px rgba(255,255,255,0.2) inset;
    display: flex;
    gap: 20px;
    padding: 48px 24px 24px;
    position: relative;
    transform: translateY(16px) scale(0.97);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
    margin: 0 16px;
    border: 1px solid rgba(255,255,255,0.3);
  }

  .shop-ai-product-modal-overlay.active .shop-ai-product-modal{
    transform: translateY(0) scale(1);
  }

  .shop-ai-product-modal-left{
    flex: 0 0 220px;
    border-radius: 14px;
    overflow: hidden;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
  }

  .shop-ai-product-modal-left img{
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop-ai-product-modal-right{
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .shop-ai-product-modal-title{
    font-size: 18px;
    font-weight: 700;
    color: var(--shop-ai-text);
    line-height: 1.3;
  }

  .shop-ai-product-modal-price{
    font-size: 18px;
    font-weight: 700;
    color: var(--shop-ai-primary);
  }

  .shop-ai-product-modal-sku{
    font-size: 12px;
    color: var(--shop-ai-text-light);
    font-weight: 500;
  }

  .shop-ai-product-modal-description{
    font-size: 14px;
    color: var(--shop-ai-text-light);
    line-height: 1.5;
    max-height: 80px;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .shop-ai-product-modal-actions{
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .shop-ai-product-modal-primary{
    flex: 1;
    min-width: 0;
    padding: 12px 20px;
    border-radius: 999px;
    border: none;
    background: var(--shop-ai-gradient);
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
  }

  .shop-ai-product-modal-primary:hover{
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255,157,92,0.3);
  }

  .shop-ai-product-modal-primary:active{
    transform: translateY(0) scale(0.97);
    transition-duration: 0.1s;
  }

  .shop-ai-product-modal-secondary{
    padding: 12px 20px;
    border-radius: 999px;
    border: 1px solid var(--shop-ai-border);
    background: #ffffff;
    color: var(--shop-ai-text);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .shop-ai-product-modal-secondary:hover{
    border-color: var(--shop-ai-primary);
    background: rgba(255,157,92,0.04);
  }

  .shop-ai-product-modal-close{
    position: absolute;
    top: 14px;
    right: 14px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--shop-ai-border);
    background: rgba(255,255,255,0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .shop-ai-product-modal-close:hover{
    background: rgba(0,0,0,0.06);
    transform: scale(1.08);
  }

  .shop-ai-product-modal-close:active{
    transform: scale(0.94);
  }

  .shop-ai-product-modal-close svg{
    width: 14px;
    height: 14px;
  }

  /* ============================================
     THINKING UI - PREMIUM SHIMMER + DOTS
     ============================================ */
  .shop-ai-thinking-container{
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    background: rgba(0,0,0,0.025);
    border-radius: 18px;
    border-top-left-radius: 4px;
    align-self: flex-start;
    animation: messageSlide 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .shop-ai-thinking-container::before{
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 25%, rgba(255,157,92,0.05) 37%, transparent 63%);
    background-size: 200% 100%;
    animation: shimmer 2s ease-in-out infinite;
  }

  @keyframes shimmer{
    0%{ background-position: 200% 0; }
    100%{ background-position: -200% 0; }
  }

  .shop-ai-thinking-dots{
    display: flex;
    gap: 4px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .shop-ai-thinking-dots span{
    width: 6px;
    height: 6px;
    background: var(--shop-ai-primary);
    border-radius: 50%;
    animation: dotPulse 1.4s ease-in-out infinite;
  }

  .shop-ai-thinking-dots span:nth-child(2){ animation-delay: 0.16s; }
  .shop-ai-thinking-dots span:nth-child(3){ animation-delay: 0.32s; }

  @keyframes dotPulse{
    0%, 80%, 100%{ transform: scale(0.5); opacity: 0.3; }
    40%{ transform: scale(1.1); opacity: 1; }
  }

  .shop-ai-thinking-text{
    font-size: 13px;
    font-weight: 500;
    color: var(--shop-ai-text-light);
    transition: opacity 0.2s ease;
    position: relative;
    z-index: 1;
  }

  /* ============================================
     INPUT AREA - PREMIUM CLAUDE/CHATGPT STYLE
     ============================================ */
  .shop-ai-input-area{
    padding: 12px 16px 16px;
    background: transparent;
  }

  .shop-ai-input-wrapper{
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding: 10px 10px 10px 18px;
    background: rgba(255,255,255,0.92);
    border: 1px solid rgba(0,0,0,0.07);
    border-radius: 24px;
    box-shadow: 0 1px 6px rgba(0,0,0,0.03);
    transition: border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .shop-ai-input-wrapper:focus-within{
    border-color: rgba(255,157,92,0.35);
    box-shadow: 0 2px 10px rgba(255,157,92,0.08), 0 0 0 3px rgba(255,157,92,0.05);
  }

  .shop-ai-textarea{
    flex: 1;
    border: none;
    outline: none;
    resize: none;
    font-size: 15px;
    line-height: 1.5;
    color: var(--shop-ai-text);
    font-family: var(--shop-ai-font);
    max-height: 120px;
    min-height: 24px;
    background: transparent;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .shop-ai-textarea::placeholder{
    color: var(--shop-ai-text-light);
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }

  .shop-ai-textarea.placeholder-fade::placeholder{
    opacity: 0;
  }

  .shop-ai-send-btn{
    width: 36px;
    height: 36px;
    min-width: 36px;
    border-radius: 50%;
    background: var(--shop-ai-gradient);
    border: none;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0.3;
    pointer-events: none;
    transform: scale(0.85);
  }

  .shop-ai-send-btn.active{
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }

  .shop-ai-send-btn:hover{
    transform: translateY(-1px) scale(1.06);
    box-shadow: 0 4px 14px rgba(255,157,92,0.35);
  }

  .shop-ai-send-btn:active{
    transform: scale(0.92);
    transition-duration: 0.1s;
  }

  .shop-ai-send-btn svg{
    width: 18px;
    height: 18px;
  }

  /* ============================================
     EMAIL CAPTURE POPUP
     ============================================ */
  .shop-ai-email-overlay{
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .shop-ai-email-overlay.active{
    opacity: 1;
    visibility: visible;
  }

  .shop-ai-email-popup{
    background: rgba(255,255,255,0.96);
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    border-radius: 24px;
    padding: 36px 32px;
    max-width: 420px;
    width: 90%;
    box-shadow: 0 20px 60px rgba(0,0,0,0.12), 0 0 0 1px rgba(255,255,255,0.2) inset;
    border: 1px solid rgba(255,255,255,0.3);
    animation: popupSlide 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    text-align: center;
  }

  @keyframes popupSlide{
    from{
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to{
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .shop-ai-email-icon{
    width: 64px;
    height: 64px;
    margin: 0 auto 20px;
    background: var(--shop-ai-gradient);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shop-ai-email-icon svg{
    width: 32px;
    height: 32px;
    color: white;
  }

  .shop-ai-email-title{
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 10px 0;
    color: var(--shop-ai-text);
  }

  .shop-ai-email-subtitle{
    font-size: 15px;
    color: var(--shop-ai-text-light);
    margin: 0 0 24px 0;
  }

  .shop-ai-email-input-wrapper{
    position: relative;
    margin-bottom: 16px;
  }

  .shop-ai-email-input{
    width: 100%;
    padding: 14px 18px;
    border: 2px solid var(--shop-ai-border);
    border-radius: 12px;
    font-size: 15px;
    outline: none;
    transition: all 0.2s ease;
  }

  .shop-ai-email-input:focus{
    border-color: var(--shop-ai-primary);
  }

  .shop-ai-email-error{
    color: #ef4444;
    font-size: 13px;
    margin-top: 8px;
    display: none;
  }

  .shop-ai-email-error.visible{
    display: block;
  }

  .shop-ai-email-submit{
    width: 100%;
    padding: 14px;
    background: var(--shop-ai-gradient);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    margin-bottom: 12px;
  }

  .shop-ai-email-submit:hover{
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255,157,92,0.3);
  }

  .shop-ai-email-submit:active{
    transform: translateY(0) scale(0.98);
    transition-duration: 0.1s;
  }

  .shop-ai-email-skip{
    background: transparent;
    color: var(--shop-ai-text-light);
    border: none;
    padding: 10px;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .shop-ai-email-skip:hover{
    color: var(--shop-ai-text);
  }

  /* ============================================
     HISTORY PANEL
     ============================================ */
  .shop-ai-history-panel{
    position: absolute;
    inset: 0;
    background: white;
    z-index: 50;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .shop-ai-history-panel.active{
    transform: translateX(0);
  }

  .shop-ai-history-header{
    padding: 24px;
    border-bottom: 1px solid var(--shop-ai-border);
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .shop-ai-history-header h3{
    font-size: 18px;
    font-weight: 700;
    margin: 0;
  }

  .shop-ai-back-btn{
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0,0,0,0.04);
    border: 1px solid var(--shop-ai-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .shop-ai-back-btn:hover{
    background: rgba(255,157,92,0.1);
  }

  .shop-ai-history-list{
    flex: 1;
    overflow-y: auto;
    padding: 16px;
  }

  .shop-ai-history-item{
    padding: 16px;
    border: 1px solid var(--shop-ai-border);
    border-radius: 12px;
    margin-bottom: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .shop-ai-history-item:hover{
    border-color: var(--shop-ai-primary);
    transform: translateX(6px);
  }

  .shop-ai-history-item-title{
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--shop-ai-text);
  }

  .shop-ai-history-item-time{
    font-size: 13px;
    color: var(--shop-ai-text-light);
  }

  .shop-ai-history-empty{
    text-align: center;
    padding: 48px 24px;
    color: var(--shop-ai-text-light);
    font-size: 14px;
  }

  .shop-ai-history-loading{
    text-align: center;
    padding: 32px;
    color: var(--shop-ai-text-light);
    font-size: 14px;
  }

  /* ============================================
     MOBILE RESPONSIVE
     ============================================ */

  /* ---- Tablet (768px) ---- */
  @media (max-width: 768px){
    .shop-ai-modal{
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      border-radius: 0;
      top: 0;
      left: 0;
      transform: translateY(100%);
    }

    body.shop-ai-open .shop-ai-modal{
      transform: translateY(0);
    }
    .shop-ai-modal.active{
      transform: translateY(0);
    }

    .shop-ai-header{
      padding: max(16px, env(safe-area-inset-top)) 16px 14px;
    }

    .shop-ai-messages{
      padding: 16px;
      gap: 12px;
    }

    .shop-ai-input-area{
      padding: 10px 12px max(12px, env(safe-area-inset-bottom));
    }

    .shop-ai-input-wrapper{
      padding: 8px 8px 8px 14px;
    }

    /* Carousel always horizontal on mobile */
    .shop-ai-product-grid{
      gap: 10px;
      padding: 6px 2px 10px;
    }

    .shop-ai-product-card{
      flex: 0 0 130px;
    }

    .shop-ai-product-image{
      height: 130px;
    }

    /* Product modal stacks vertically */
    .shop-ai-product-modal{
      flex-direction: column;
      max-width: 100%;
      margin: 0 12px;
      padding: 44px 16px 16px;
      gap: 16px;
      max-height: 85vh;
      overflow-y: auto;
    }

    .shop-ai-product-modal-left{
      flex: 0 0 auto;
      width: 100%;
      max-height: 220px;
      aspect-ratio: auto;
    }

    .shop-ai-product-modal-right{
      width: 100%;
    }

    .shop-ai-product-modal-actions{
      flex-direction: column;
    }

    .shop-ai-product-modal-secondary{
      text-align: center;
    }

    /* Message bubbles */
    .shop-ai-message.user{
      max-width: 85%;
    }

    .shop-ai-message.assistant{
      max-width: 92%;
    }

    /* Suggestions */
    .shop-ai-sugg-item{
      padding: 12px 14px;
      font-size: 13px;
    }

    .shop-ai-sugg-item:hover{
      transform: none;
    }

    /* Email popup */
    .shop-ai-email-popup{
      padding: 28px 20px;
      width: 94%;
    }

    .shop-ai-email-title{
      font-size: 20px;
    }
  }

  /* ---- Small phone (480px) ---- */
  @media (max-width: 480px){
    .shop-ai-header h3{
      font-size: 16px;
    }

    .shop-ai-messages{
      padding: 12px;
      gap: 10px;
    }

    .shop-ai-input-area{
      padding: 8px 8px max(10px, env(safe-area-inset-bottom));
    }

    .shop-ai-input-wrapper{
      padding: 6px 6px 6px 12px;
      border-radius: 20px;
    }

    .shop-ai-textarea{
      font-size: 14px;
      min-height: 22px;
    }

    .shop-ai-send-btn{
      width: 32px;
      height: 32px;
      min-width: 32px;
    }

    .shop-ai-send-btn svg{
      width: 16px;
      height: 16px;
    }

    /* Product carousel */
    .shop-ai-product-grid{
      gap: 8px;
      padding: 6px 1px 10px;
    }

    .shop-ai-product-card{
      flex: 0 0 120px;
    }

    .shop-ai-product-image{
      height: 110px;
    }

    .shop-ai-product-info{
      padding: 8px;
    }

    .shop-ai-product-title{
      font-size: 12px;
    }

    .shop-ai-product-price{
      font-size: 12px;
    }

    /* Product modal full-width on small phones */
    .shop-ai-product-modal{
      margin: 0 8px;
      padding: 40px 14px 14px;
      border-radius: 18px;
      gap: 12px;
    }

    .shop-ai-product-modal-left{
      max-height: 180px;
      border-radius: 10px;
    }

    .shop-ai-product-modal-title{
      font-size: 16px;
    }

    .shop-ai-product-modal-price{
      font-size: 16px;
    }

    .shop-ai-product-modal-primary,
    .shop-ai-product-modal-secondary{
      padding: 10px 16px;
      font-size: 13px;
    }

    /* Message bubbles */
    .shop-ai-message.user .shop-ai-bubble{
      padding: 8px 12px;
      font-size: 14px;
    }

    .shop-ai-message.assistant .shop-ai-bubble{
      padding: 12px 14px;
      font-size: 14px;
    }

    /* Thinking */
    .shop-ai-thinking-container{
      padding: 10px 14px;
    }

    .shop-ai-thinking-text{
      font-size: 12px;
    }

    /* Suggestion items */
    .shop-ai-sugg-item{
      padding: 10px 12px;
      font-size: 12px;
      gap: 8px;
    }

    .shop-ai-sugg-item svg{
      width: 16px;
      height: 16px;
    }

    /* Email popup compact */
    .shop-ai-email-popup{
      padding: 24px 16px;
      border-radius: 18px;
    }

    .shop-ai-email-icon{
      width: 52px;
      height: 52px;
      margin-bottom: 16px;
    }

    .shop-ai-email-icon svg{
      width: 24px;
      height: 24px;
    }

    .shop-ai-email-title{
      font-size: 18px;
    }

    .shop-ai-email-subtitle{
      font-size: 13px;
      margin-bottom: 18px;
    }

    /* Menu dropdown */
    .shop-ai-menu-dropdown{
      min-width: 180px;
    }

    .shop-ai-menu-item{
      padding: 12px 14px;
      font-size: 13px;
    }

    /* History panel */
    .shop-ai-history-header{
      padding: 16px;
    }

    .shop-ai-history-header h3{
      font-size: 16px;
    }

    .shop-ai-history-list{
      padding: 12px;
    }

    .shop-ai-history-item{
      padding: 12px;
      margin-bottom: 8px;
    }
  }

  /* ---- Extra small phone (320px) ---- */
  @media (max-width: 320px){
    .shop-ai-header h3{
      font-size: 14px;
    }

    .shop-ai-icon-btn{
      width: 34px;
      height: 34px;
    }

    .shop-ai-product-card{
      flex: 0 0 100px;
    }

    .shop-ai-product-image{
      height: 90px;
    }

    .shop-ai-product-info{
      padding: 6px;
    }

    .shop-ai-product-title{
      font-size: 11px;
    }

    .shop-ai-product-price{
      font-size: 11px;
    }
  }

  /* ---- Prevent overflow on all sizes ---- */
  .shop-ai-reset,
  .shop-ai-modal,
  .shop-ai-input-area{
    overflow-x: hidden;
  }

  .shop-ai-bubble{
    word-wrap: break-word;
    overflow-wrap: break-word;
    word-break: break-word;
    max-width: 100%;
  }

  .shop-ai-message{
    max-width: 100%;
    min-width: 0;
  }
</style>

<div class="shop-ai-reset" aria-hidden="false">
  <!-- Floating Launcher (HIDDEN — button is injected into header via JS below) -->
  <div class="shop-ai-floating-group" id="shop-ai-floating-group">
    <!-- kept in DOM for chat.js compatibility but hidden via CSS -->
    <button class="shop-ai-pill-btn shop-ai-btn-primary" data-trigger="ask" aria-label="Ask AI">Ask AI</button>
  </div>

  <!-- Backdrop -->
  <div class="shop-ai-backdrop" id="shop-ai-backdrop"></div>

  <!-- Main Modal -->
  <div class="shop-ai-modal" id="shop-ai-modal" role="dialog" aria-modal="true" aria-label="AI Assistant">
    <!-- Header -->
    <div class="shop-ai-header">
      <h3>Hi, how can I help you?</h3>

      <div class="shop-ai-header-actions">
        <button class="shop-ai-icon-btn shop-ai-menu-btn" id="shop-ai-menu-btn" aria-label="Menu">
          <div class="shop-ai-3dot-icon">
            <span></span>
            <span></span>
            <span></span>
          </div>
        </button>
        <button class="shop-ai-icon-btn" id="shop-ai-close-btn" aria-label="Close">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Dropdown Menu -->
    <div class="shop-ai-menu-dropdown" id="shop-ai-menu">
      <button class="shop-ai-menu-item" data-action="new">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
        </svg>
        New chat
      </button>
      <button class="shop-ai-menu-item" data-action="history">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12,6 12,12 16,14"/>
        </svg>
        Previous chats
      </button>
      <button class="shop-ai-menu-item danger" data-action="end">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="15" y1="9" x2="9" y2="15"/>
          <line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
        End chat
      </button>
    </div>

    <!-- Email Capture Overlay -->
    <div class="shop-ai-email-overlay" id="shop-ai-email-overlay">
      <div class="shop-ai-email-popup">
        <div class="shop-ai-email-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <h3 class="shop-ai-email-title">Stay Connected</h3>
        <p class="shop-ai-email-subtitle">Get exclusive offers and product updates</p>
        <div class="shop-ai-email-input-wrapper">
          <input
            type="email"
            class="shop-ai-email-input"
            id="shop-ai-email-input"
            placeholder="Enter your email..."
            autocomplete="email"
          />
          <p class="shop-ai-email-error" id="shop-ai-email-error">Please enter a valid email</p>
        </div>
        <button class="shop-ai-email-submit" id="shop-ai-email-submit">Continue</button>
        <button class="shop-ai-email-skip" id="shop-ai-email-skip">Skip for now</button>
      </div>
    </div>

    <!-- Messages Area -->
    <div class="shop-ai-messages" id="shop-ai-messages">
      <!-- Suggestions -->
      <div class="shop-ai-suggestions visible" id="shop-ai-suggestions">
