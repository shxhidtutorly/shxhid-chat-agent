<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<style>
  /* ============================================
     UPDATED STYLES - PURPLE MODAL DESIGN
     ============================================ */
  
  :root {
    --primary-gradient: linear-gradient(135deg, #8B7FD8 0%, #6B5FCE 100%);
    --primary-color: #8B7FD8;
  }

  /* HIDE LEGACY CHAT BUBBLE */
  .shop-ai-chat-bubble {
    display: none !important;
  }

  /* CENTERED MODAL WITH BACKDROP */
  .shop-ai-chat-container {
    position: fixed;
    inset: 0;
    z-index: 999999;
    pointer-events: none;
  }

  /* Backdrop blur */
  .shop-ai-chat-container::before {
    content: '';
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    pointer-events: none;
  }

  .shop-ai-chat-container.modal-open::before {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Floating buttons */
  .shop-ai-floating-group {
    position: fixed;
    bottom: 24px;
    right: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-end;
    z-index: 999999;
    pointer-events: auto;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .shop-ai-floating-group.hidden {
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
  }

  .shop-ai-secondary-btn,
  .shop-ai-primary-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    border-radius: 9999px;
    border: none;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    transform: translateY(20px);
  }

  .shop-ai-secondary-btn.visible,
  .shop-ai-primary-btn.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .shop-ai-secondary-btn {
    background: white;
    color: #1a1a1a;
    border: 1px solid #e5e7eb;
  }

  .shop-ai-secondary-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.2);
  }

  .shop-ai-primary-btn {
    background: var(--primary-gradient);
    color: white;
    box-shadow: 0 6px 25px rgba(139, 127, 216, 0.4);
  }

  .shop-ai-primary-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(139, 127, 216, 0.5);
  }

  /* MODAL CENTERED */
  .shop-ai-chat-window {
    position: fixed !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) scale(0.9) !important;
    width: 90% !important;
    max-width: 680px !important;
    height: 85vh !important;
    max-height: 720px !important;
    bottom: auto !important;
    right: auto !important;
    border-radius: 24px !important;
    box-shadow: 0 25px 80px -15px rgba(0, 0, 0, 0.4) !important;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: auto;
  }

  .shop-ai-chat-window.active {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translate(-50%, -50%) scale(1) !important;
  }

  /* PURPLE GRADIENT HEADER */
  .shop-ai-chat-header {
    background: var(--primary-gradient) !important;
    color: white !important;
    padding: 20px 24px !important;
    border-radius: 24px 24px 0 0 !important;
  }

  .shop-ai-chat-header h3 {
    color: white !important;
  }

  .shop-ai-chat-header p {
    color: rgba(255, 255, 255, 0.9) !important;
  }

  .shop-ai-status-dot {
    background: #10b981 !important;
    box-shadow: 0 0 10px #10b981 !important;
  }

  .shop-ai-header-btn {
    background: rgba(255, 255, 255, 0.2) !important;
    color: white !important;
    border: none !important;
  }

  .shop-ai-header-btn:hover {
    background: rgba(255, 255, 255, 0.3) !important;
  }

  /* SUGGESTIONS PANEL */
  .shop-ai-suggestions-panel {
    padding: 24px;
    display: none;
  }

  .shop-ai-suggestions-panel.active {
    display: block;
  }

  .shop-ai-suggestions-title {
    font-size: 13px;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .shop-ai-suggestion-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px;
  }

  .shop-ai-suggestion-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 14px;
    color: #1a1a1a;
    width: 100%;
    text-align: left;
  }

  .shop-ai-suggestion-item:hover {
    border-color: var(--primary-color);
    background: #f9fafb;
    transform: translateX(4px);
  }

  .shop-ai-suggestion-item svg {
    width: 18px;
    height: 18px;
    color: #9ca3af;
    flex-shrink: 0;
  }

  .shop-ai-quick-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .shop-ai-quick-action {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 500;
    color: #1a1a1a;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .shop-ai-quick-action:hover {
    border-color: var(--primary-color);
    color: var(--primary-color);
    background: rgba(139, 127, 216, 0.05);
  }

  .shop-ai-quick-action svg {
    width: 16px;
    height: 16px;
  }

  /* 3-STAGE THINKING ANIMATION */
  .shop-ai-thinking-stages {
    align-self: flex-start;
    max-width: 85%;
    background: #f3f4f6;
    padding: 14px 18px;
    border-radius: 16px;
    border-bottom-left-radius: 4px;
  }

  .shop-ai-thinking-stage {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: #6b7280;
    margin-bottom: 8px;
    opacity: 0;
    animation: stageFadeIn 0.4s ease forwards;
  }

  .shop-ai-thinking-stage:last-child {
    margin-bottom: 0;
  }

  .shop-ai-thinking-stage.active {
    color: #1a1a1a;
    opacity: 1;
  }

  .shop-ai-thinking-stage.complete {
    opacity: 0.5;
  }

  @keyframes stageFadeIn {
    to { opacity: 1; }
  }

  .shop-ai-dots {
    display: inline-flex;
    gap: 3px;
  }

  .shop-ai-dots span {
    width: 4px;
    height: 4px;
    background: currentColor;
    border-radius: 50%;
    animation: dotPulse 1.4s ease-in-out infinite;
  }

  .shop-ai-dots span:nth-child(2) { animation-delay: 0.2s; }
  .shop-ai-dots span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes dotPulse {
    0%, 60%, 100% { opacity: 0.3; transform: scale(0.8); }
    30% { opacity: 1; transform: scale(1.2); }
  }

  .shop-ai-shimmer-bar {
    width: 100%;
    height: 3px;
    background: #e5e7eb;
    border-radius: 2px;
    overflow: hidden;
    margin-top: 12px;
  }

  .shop-ai-shimmer-bar::after {
    content: '';
    display: block;
    width: 40%;
    height: 100%;
    background: var(--primary-color);
    animation: shimmerMove 1.5s ease-in-out infinite;
  }

  @keyframes shimmerMove {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(350%); }
  }

  /* HIDE OLD THINKING */
  .shop-ai-thinking-placeholder {
    display: none !important;
  }

  /* Remove voice/mic buttons completely */
  .shop-ai-voice-btn,
  button[title="Voice input"],
  [aria-label*="voice" i],
  [aria-label*="mic" i] {
    display: none !important;
  }

  /* Text Shimmer Animation for old "AI Thinking" - KEEP AS FALLBACK */
  @keyframes shimmerText {
    0% { background-position: 100% center; }
    100% { background-position: 0% center; }
  }

  .shop-ai-thinking-text {
    font-size: 14px;
    font-weight: 500;
    background: linear-gradient(
      90deg,
      transparent 0%,
      transparent calc(50% - 50px),
      #1a1a1a calc(50%),
      transparent calc(50% + 50px),
      transparent 100%
    ), linear-gradient(#9ca3af, #9ca3af);
    background-size: 250% 100%, auto;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    animation: shimmerText 2s linear infinite;
  }

  /* Spinner for thinking icon */
  .shop-ai-spinner {
    width: 18px;
    height: 18px;
    border: 2px solid #e5e7eb;
    border-top-color: #1a1a1a;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Hide tool-use messages */
  .shop-ai-message.tool-use {
    display: none !important;
  }

  /* Markdown formatting */
  .shop-ai-message.assistant .shop-ai-message-bubble {
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  .shop-ai-message.assistant .shop-ai-message-content {
    padding: 14px 18px;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    border-bottom-left-radius: 4px;
    font-size: 14.5px;
    line-height: 1.6;
    color: #1a1a1a;
  }

  .shop-ai-message.assistant .shop-ai-message-content p {
    margin: 0 0 12px 0;
  }

  .shop-ai-message.assistant .shop-ai-message-content p:last-child {
    margin-bottom: 0;
  }

  .shop-ai-message.assistant .shop-ai-message-content strong,
  .shop-ai-message.assistant .shop-ai-message-content b {
    font-weight: 600;
    color: #1a1a1a;
  }

  .shop-ai-message.assistant .shop-ai-message-content ul,
  .shop-ai-message.assistant .shop-ai-message-content ol {
    margin: 12px 0;
    padding-left: 20px;
  }

  .shop-ai-message.assistant .shop-ai-message-content li {
    margin-bottom: 8px;
    line-height: 1.5;
  }

  .shop-ai-message.assistant .shop-ai-message-content code {
    background: rgba(0, 0, 0, 0.06);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'SF Mono', Monaco, monospace;
    font-size: 13px;
  }

  .shop-ai-message.assistant .shop-ai-message-content a {
    color: var(--primary-color);
    text-decoration: underline;
  }

  /* Modern Input */
  .shop-ai-chat-input {
    border-top: 1px solid #e5e7eb;
    padding: 16px 20px 20px;
    background: white;
  }

  .shop-ai-textarea-wrapper {
    position: relative;
    background: #f3f4f6;
    border-radius: 28px;
    transition: all 0.2s ease;
  }

  .shop-ai-textarea-wrapper:focus-within {
    background: white;
    box-shadow: 0 0 0 2px var(--primary-color);
  }

  .shop-ai-textarea {
    width: 100%;
    min-height: 56px;
    max-height: 150px;
    padding: 16px 56px 16px 22px;
    border: none;
    background: transparent;
    font-size: 15px;
    line-height: 1.4;
    resize: none;
    outline: none;
    color: #1a1a1a;
  }

  .shop-ai-textarea::placeholder {
    color: #9ca3af;
  }

  .shop-ai-submit-btn {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.06);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    color: #1a1a1a;
  }

  .shop-ai-submit-btn:hover:not(:disabled) {
    background: var(--primary-gradient);
    color: white;
  }

  .shop-ai-submit-btn.has-text svg {
    opacity: 1;
  }

  .shop-ai-submit-btn:not(.has-text) svg {
    opacity: 0.4;
  }

  .shop-ai-submit-spinner {
    width: 16px;
    height: 16px;
    background: var(--primary-color);
    border-radius: 3px;
    animation: spinSquare 2.5s linear infinite;
  }

  @keyframes spinSquare {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .shop-ai-input-status {
    padding: 8px 22px 0;
    font-size: 12px;
    color: #9ca3af;
    height: 20px;
  }

  /* Override old styles */
  .shop-ai-input-wrapper {
    display: none !important;
  }

  /* EMAIL POPUP */
  .shop-ai-email-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.98);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    border-radius: 24px;
  }

  .shop-ai-email-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .shop-ai-email-popup {
    width: 100%;
    max-width: 320px;
    padding: 32px 24px;
    text-align: center;
    animation: popupSlideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes popupSlideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .shop-ai-email-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 20px;
    background: var(--primary-gradient);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(139, 127, 216, 0.3);
  }

  .shop-ai-email-icon svg {
    width: 32px;
    height: 32px;
    color: white;
  }

  .shop-ai-email-title {
    font-size: 20px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 8px 0;
  }

  .shop-ai-email-subtitle {
    font-size: 14px;
    color: #6b7280;
    margin: 0 0 24px 0;
  }

  .shop-ai-email-input {
    width: 100%;
    padding: 14px 18px;
    border: 2px solid #e5e7eb;
    border-radius: 12px;
    font-size: 15px;
    outline: none;
    transition: all 0.2s ease;
    background: #fafafa;
    margin-bottom: 16px;
  }

  .shop-ai-email-input:focus {
    border-color: var(--primary-color);
    background: white;
  }

  .shop-ai-email-submit {
    width: 100%;
    padding: 14px 24px;
    background: var(--primary-gradient);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-bottom: 12px;
  }

  .shop-ai-email-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(139, 127, 216, 0.4);
  }

  .shop-ai-email-skip {
    background: none;
    border: none;
    color: #6b7280;
    font-size: 14px;
    cursor: pointer;
    padding: 8px 16px;
  }

  .shop-ai-email-skip:hover {
    color: #1a1a1a;
  }

  .shop-ai-email-error {
    color: #ef4444;
    font-size: 13px;
    margin-top: -8px;
    margin-bottom: 8px;
    display: none;
  }

  .shop-ai-email-error.visible {
    display: block;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .shop-ai-chat-window {
      width: 100% !important;
      height: 100% !important;
      max-height: none !important;
      border-radius: 0 !important;
      top: 0 !important;
      left: 0 !important;
      transform: translateY(100%) !important;
    }

    .shop-ai-chat-window.active {
      transform: translateY(0) !important;
    }

    .shop-ai-chat-header {
      border-radius: 0 !important;
    }
  }
</style>

<div class="shop-ai-chat-container" id="shop-ai-container">
  
  <!-- Floating Buttons -->
  <div class="shop-ai-floating-group" id="shop-ai-floating-group">
    <button class="shop-ai-secondary-btn visible" data-action="open-chat">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
      </svg>
      <span>Chat with our AI</span>
    </button>
    
    <button class="shop-ai-secondary-btn visible" data-action="open-chat">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/>
        <line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
      <span>Help me choose</span>
    </button>
    
    <button class="shop-ai-primary-btn visible" data-action="open-chat">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2L13.5 8.5L20 10L13.5 11.5L12 18L10.5 11.5L4 10L10.5 8.5L12 2Z"/>
      </svg>
      <span>Ask our AI</span>
    </button>
  </div>

  <!-- Chat Window -->
  <div class="shop-ai-chat-window" id="shop-ai-chat-window">
    
    <!-- Header -->
    <div class="shop-ai-chat-header">
      <div class="shop-ai-header-left">
        <div class="shop-ai-avatar">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L13.5 8.5L20 10L13.5 11.5L12 18L10.5 11.5L4 10L10.5 8.5L12 2Z"/>
          </svg>
        </div>
        <div class="shop-ai-header-info">
          <h3>Hi, how can I help you?</h3>
          <p><span class="shop-ai-status-dot"></span> Online now</p>
        </div>
      </div>
      
      <div class="shop-ai-header-actions">
        <button class="shop-ai-header-btn shop-ai-menu-btn" id="shop-ai-menu-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="1.5"/>
            <circle cx="12" cy="5" r="1.5"/>
            <circle cx="12" cy="19" r="1.5"/>
          </svg>
        </button>
        
        <button class="shop-ai-chat-close" id="shop-ai-close-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
        
        <!-- Dropdown Menu -->
        <div class="shop-ai-dropdown-menu" id="shop-ai-dropdown-menu">
          <button class="shop-ai-menu-item" data-action="new-chat">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
            </svg>
            <span>Start a new chat</span>
          </button>
          <button class="shop-ai-menu-item" data-action="show-history">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12,6 12,12 16,14"/>
            </svg>
            <span>View recent chats</span>
          </button>
          <div class="shop-ai-menu-divider"></div>
          <button class="shop-ai-menu-item danger" data-action="end-chat">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="15" y1="9" x2="9" y2="15"/>
              <line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
            <span>End chat</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Email Popup -->
    <div class="shop-ai-email-overlay" id="shop-ai-email-overlay">
      <div class="shop-ai-email-popup">
        <div class="shop-ai-email-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <h3 class="shop-ai-email-title">Stay in the loop!</h3>
        <p class="shop-ai-email-subtitle">Enter your email for exclusive offers and updates.</p>
        <input type="email" class="shop-ai-email-input" id="shop-ai-email-input" placeholder="Enter your email..."/>
        <p class="shop-ai-email-error" id="shop-ai-email-error">Please enter a valid email</p>
        <button class="shop-ai-email-submit" id="shop-ai-email-submit">Continue</button>
        <button class="shop-ai-email-skip" id="shop-ai-email-skip">Skip for now</button>
      </div>
    </div>

    <!-- Suggestions Panel (shows on first open) -->
    <div class="shop-ai-suggestions-panel" id="shop-ai-suggestions">
      <div class="shop-ai-suggestions-title">Suggestions</div>
      <div class="shop-ai-suggestion-list">
        <button class="shop-ai-suggestion-item" data-suggestion="What snowboards are currently in stock">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <span>What snowboards are currently in stock</span>
        </button>
        <button class="shop-ai-suggestion-item" data-suggestion="Where can I find information on privacy">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 3h6l3 3h9v13H3z"/>
          </svg>
          <span>Where can I find information on privacy</span>
        </button>
        <button class="shop-ai-suggestion-item" data-suggestion="Show me snowboards for videography">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <span>Show me snowboards for videography</span>
        </button>
      </div>
      
      <div class="shop-ai-suggestions-title">Quick Actions</div>
      <div class="shop-ai-quick-actions">
        <button class="shop-ai-quick-action" data-suggestion="Help me choose">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L13.5 8.5L20 10L13.5 11.5L12 18L10.5 11.5L4 10L10.5 8.5L12 2Z"/>
          </svg>
          <span>Help me choose</span>
        </button>
        <button class="shop-ai-quick-action" data-suggestion="Track my order">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="1" y="3" width="15" height="13"/><path d="M16 8h5l3 3v5h-2"/>
            <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
          <span>Track my order</span>
        </button>
        <button class="shop-ai-quick-action" data-suggestion="Previous chats">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
          </svg>
          <span>Previous chats</span>
        </button>
      </div>
    </div>

    <!-- Messages -->
    <div class="shop-ai-chat-messages" id="shop-ai-messages"></div>

    <!-- Input -->
    <div class="shop-ai-chat-input">
      <div class="shop-ai-input-container">
        <div class="shop-ai-textarea-wrapper">
          <textarea 
            class="shop-ai-textarea" 
            id="shop-ai-input" 
            placeholder="Need more details?"
            rows="1"
          ></textarea>
          <button class="shop-ai-submit-btn" id="shop-ai-send-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 2L11 13"/>
              <path d="M22 2L15 22L11 13L2 9L22 2Z"/>
            </svg>
          </button>
        </div>
        <div class="shop-ai-input-status" id="shop-ai-input-status">Ready to help!</div>
      </div>
    </div>

    <!-- History Panel -->
    <div class="shop-ai-history-panel" id="shop-ai-history-panel">
      <div class="shop-ai-history-header">
        <button class="shop-ai-back-btn" id="shop-ai-back-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15,18 9,12 15,6"/>
          </svg>
        </button>
        <h3>Recent Chats</h3>
      </div>
      <div class="shop-ai-history-list" id="shop-ai-history-list"></div>
    </div>

  </div>
</div>

<script src="{{ 'chat.js' | asset_url }}" defer></script>

<script>
  window.shopChatConfig = {
    apiUrl: '{{ shop.url }}/apps/shop-chat/chat',
    leadsUrl: '{{ shop.url }}/apps/shop-chat/leads',
    promptType: {{ block.settings.system_prompt | json }},
    welcomeMessage: {{ block.settings.welcome_message | json }}
  };
  window.shopId = {{ shop.id }};
  window.shopDomain = {{ shop.domain | json }};

  (function() {
    'use strict';

    var TOOL_MESSAGES = {
      'search_shop_catalog': 'Scouted for products',
      'search_shop_policies': 'Looking up policies',
      'get_cart': 'Checking cart',
      'update_cart': 'Updating cart',
      'add_to_cart': 'Adding to cart',
      'default': 'Thinking'
    };

    var STORAGE_KEYS = {
      conversationId: 'shopAiConversationId',
      visitorId: 'shopAiVisitorId',
      emailCaptured: 'shopAiEmailCaptured',
      chatHistory: 'shopAiChatHistory',
      emailPopupShown: 'shopAiEmailPopupShown'
    };

    var state = {
      isOpen: false,
      isSubmitting: false,
      emailCaptured: false,
      visitorId: null,
      showingSuggestions: false,
      currentStage: 0
    };

    document.addEventListener('DOMContentLoaded', function() {
      var container = document.getElementById('shop-ai-container');
      var floatingGroup = document.getElementById('shop-ai-floating-group');
      var chatWindow = document.getElementById('shop-ai-chat-window');
      var closeBtn = document.getElementById('shop-ai-close-btn');
      var menuBtn = document.getElementById('shop-ai-menu-btn');
      var dropdownMenu = document.getElementById('shop-ai-dropdown-menu');
      var historyPanel = document.getElementById('shop-ai-history-panel');
      var backBtn = document.getElementById('shop-ai-back-btn');
      var textarea = document.getElementById('shop-ai-input');
      var submitBtn = document.getElementById('shop-ai-send-btn');
      var statusText = document.getElementById('shop-ai-input-status');
      var messagesContainer = document.getElementById('shop-ai-messages');
      var suggestionsPanel = document.getElementById('shop-ai-suggestions');
      var emailOverlay = document.getElementById('shop-ai-email-overlay');
      var emailInput = document.getElementById('shop-ai-email-input');
      var emailSubmit = document.getElementById('shop-ai-email-submit');
      var emailSkip = document.getElementById('shop-ai-email-skip');
      var emailError = document.getElementById('shop-ai-email-error');

      // Initialize visitor ID
      state.visitorId = localStorage.getItem(STORAGE_KEYS.visitorId);
      if (!state.visitorId) {
        state.visitorId = 'v_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
        localStorage.setItem(STORAGE_KEYS.visitorId, state.visitorId);
      }

      state.emailCaptured = localStorage.getItem(STORAGE_KEYS.emailCaptured) === 'true';

      // OPEN CHAT
      function openChat() {
        state.isOpen = true;
        container.classList.add('modal-open');
        chatWindow.classList.add('active');
        floatingGroup.classList.add('hidden');
        document.body.style.overflow = 'hidden';

        var conversationId = sessionStorage.getItem(STORAGE_KEYS.conversationId);
        
        if (!conversationId) {
          // First time - show suggestions
          state.showingSuggestions = true;
          suggestionsPanel.classList.add('active');
          
          // Show email popup after 1.5s
          setTimeout(function() {
            if (!state.emailCaptured && !sessionStorage.getItem(STORAGE_KEYS.emailPopupShown)) {
              emailOverlay.classList.add('active');
              sessionStorage.setItem(STORAGE_KEYS.emailPopupShown, 'true');
            }
          }, 1500);
        }
      }

      // CLOSE CHAT
      function closeChat() {
        state.isOpen = false;
        container.classList.remove('modal-open');
        chatWindow.classList.remove('active');
        document.body.style.overflow = '';
        setTimeout(function() {
          floatingGroup.classList.remove('hidden');
        }, 300);
      }

      // HANDLE SUGGESTION CLICK
      function handleSuggestion(text) {
        suggestionsPanel.classList.remove('active');
        state.showingSuggestions = false;
        textarea.value = text;
        document.dispatchEvent(new CustomEvent('shop-ai-submit', { detail: { message: text } }));
      }

      // 3-STAGE THINKING ANIMATION
      function show3StageThinking(query) {
        var el = document.createElement('div');
        el.className = 'shop-ai-thinking-stages';
        el.id = 'shop-ai-thinking-stages';
        
        var keyword = extractKeyword(query);
        
        el.innerHTML = `
          <div class="shop-ai-thinking-stage" data-stage="0">
            <span>Thought about the question</span>
          </div>
          <div class="shop-ai-thinking-stage" data-stage="1">
            <span>Scouted for ${keyword}</span>
          </div>
          <div class="shop-ai-thinking-stage" data-stage="2">
            <span>Thinking</span>
            <div class="shop-ai-dots"><span></span><span></span><span></span></div>
          </div>
          <div class="shop-ai-shimmer-bar"></div>
        `;
        
        messagesContainer.appendChild(el);
        scrollToBottom();
        
        // Animate stages
        var stages = el.querySelectorAll('.shop-ai-thinking-stage');
        var timings = [800, 1000, 800];
        var currentStage = 0;
        
        function showStage(index) {
          if (index >= stages.length) return;
          
          setTimeout(function() {
            stages[index].classList.add('active');
            if (index > 0) stages[index - 1].classList.add('complete');
            
            setTimeout(function() {
              if (index < stages.length - 1) {
                showStage(index + 1);
              }
            }, timings[index]);
          }, 100);
        }
        
        showStage(0);
      }

      function extractKeyword(query) {
        var words = query.toLowerCase().split(' ');
        var keywords = ['snowboard', 'product', 'order', 'delivery', 'price', 'stock'];
        for (var i = 0; i < words.length; i++) {
          if (keywords.indexOf(words[i]) > -1) return words[i] + 's';
        }
        return 'results';
      }

      function hideThinking() {
        var el = document.getElementById('shop-ai-thinking-stages');
        if (el) el.remove();
      }

      function scrollToBottom() {
        if (messagesContainer) {
          messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
      }

      function parseMarkdown(text) {
        if (!text) return '';
        return text
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
          .replace(/\*([^*\n]+)\*/g, '<em>$1</em>')
          .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank">$1</a>')
          .replace(/\n/g, '<br>');
      }

      function addMessage(text, role) {
        var msgEl = document.createElement('div');
        msgEl.className = 'shop-ai-message ' + role;
        
        if (role === 'assistant') {
          var html = parseMarkdown(text);
          msgEl.innerHTML = '<div class="shop-ai-message-content">' + html + '</div>';
        } else {
          msgEl.textContent = text;
        }
        
        messagesContainer.appendChild(msgEl);
        scrollToBottom();
      }

      // EMAIL FUNCTIONS
      function validateEmail(email) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      }

      async function submitEmail() {
        var email = emailInput.value.trim();
        if (!validateEmail(email)) {
          emailError.classList.add('visible');
          return;
        }
        
        emailError.classList.remove('visible');
        emailSubmit.disabled = true;
        emailSubmit.textContent = 'Saving...';
        
        try {
          var response = await fetch(window.shopChatConfig.leadsUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: email,
              visitorId: state.visitorId,
              captureSource: 'chat_popup'
            })
          });
          
          if (response.ok) {
            state.emailCaptured = true;
            localStorage.setItem(STORAGE_KEYS.emailCaptured, 'true');
            emailSubmit.textContent = '✓ Thanks!';
            setTimeout(function() {
              emailOverlay.classList.remove('active');
            }, 1000);
          }
        } catch (error) {
          emailSubmit.textContent = 'Continue';
          emailSubmit.disabled = false;
        }
      }

      // EVENT BINDINGS
      floatingGroup.addEventListener('click', function(e) {
        if (e.target.closest('[data-action="open-chat"]')) openChat();
      });

      closeBtn.addEventListener('click', closeChat);
      menuBtn.addEventListener('click', function() {
        dropdownMenu.classList.toggle('active');
      });

      suggestionsPanel.addEventListener('click', function(e) {
        var item = e.target.closest('.shop-ai-suggestion-item, .shop-ai-quick-action');
        if (item) handleSuggestion(item.dataset.suggestion);
      });

      dropdownMenu.addEventListener('click', function(e) {
        var item = e.target.closest('.shop-ai-menu-item');
        if (!item) return;
        
        dropdownMenu.classList.remove('active');
        
        if (item.dataset.action === 'new-chat') {
          sessionStorage.removeItem(STORAGE_KEYS.conversationId);
          messagesContainer.innerHTML = '';
          suggestionsPanel.classList.add('active');
          state.showingSuggestions = true;
        } else if (item.dataset.action === 'show-history') {
          historyPanel.classList.add('active');
        } else if (item.dataset.action === 'end-chat') {
          addMessage('Chat ended. Thanks!', 'assistant');
        }
      });

      backBtn.addEventListener('click', function() {
        historyPanel.classList.remove('active');
      });

      emailSubmit.addEventListener('click', submitEmail);
      emailSkip.addEventListener('click', function() {
        emailOverlay.classList.remove('active');
      });

      textarea.addEventListener('input', function() {
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 150) + 'px';
        submitBtn.classList.toggle('has-text', this.value.trim().length > 0);
      });

      textarea.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          if (this.value.trim()) {
            document.dispatchEvent(new CustomEvent('shop-ai-submit', { detail: { message: this.value.trim() } }));
          }
        }
      });

      submitBtn.addEventListener('click', function() {
        if (textarea.value.trim()) {
          document.dispatchEvent(new CustomEvent('shop-ai-submit', { detail: { message: textarea.value.trim() } }));
        }
      });

      // Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          if (emailOverlay.classList.contains('active')) {
            emailOverlay.classList.remove('active');
          } else if (state.isOpen) {
            closeChat();
          }
        }
      });

      // PUBLIC API
      window.ShopAIChat = {
        open: openChat,
        close: closeChat,
        showThinking: function(query) {
          show3StageThinking(query);
        },
        hideThinking: hideThinking,
        addMessage: addMessage,
        scrollToBottom: scrollToBottom,
        getVisitorId: function() { return state.visitorId; }
      };

      // Listen for submit event from chat.js
      document.addEventListener('shop-ai-submit', function(e) {
        if (suggestionsPanel.classList.contains('active')) {
          suggestionsPanel.classList.remove('active');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "AI Chat Assistant",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "chat_title",
      "label": "Chat Title",
      "default": "AI Assistant"
    },
    {
      "type": "text",
      "id": "welcome_message",
      "label": "Welcome Message",
      "default": "Hi! How can I help you today?"
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input Placeholder",
      "default": "Need more details?"
    },
    {
      "type": "select",
      "id": "system_prompt",
      "label": "System Prompt",
      "options": [
        {"value": "standardAssistant", "label": "Standard Assistant"},
        {"value": "enthusiasticAssistant", "label": "Enthusiastic Assistant"}
      ],
      "default": "standardAssistant"
    }
  ]
}
{% endschema %}
