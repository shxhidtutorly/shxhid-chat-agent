<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<style>
  /* ============================================
     EXACT UI MATCH - PURPLE/WHITE THEME
     ============================================ */
  :root{
    --ai-primary: #5B4DFF;
    --ai-primary-dark: #4A3FE0;
    --ai-gradient: linear-gradient(135deg, #8B7BFF 0%, #5B4DFF 50%, #4A3FE0 100%);
    --ai-bg: #ffffff;
    --ai-text: #1a1a1a;
    --ai-text-light: #6B7280;
    --ai-border: #E5E7EB;
    --ai-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    --ai-shadow-lg: 0 35px 60px -15px rgba(0, 0, 0, 0.3);
    --ai-radius: 16px;
    --ai-radius-lg: 20px;
    --ai-font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  .shop-ai-reset *{
    box-sizing: border-box;
    font-family: var(--ai-font);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* ============================================
     FLOATING LAUNCHER - COMPACT PILL
     ============================================ */
  .shop-ai-floating-group{
    position: fixed;
    bottom: 20px;
    right: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    z-index: 999990;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .shop-ai-floating-group.hidden{
    opacity: 0;
    transform: translateY(20px) scale(0.9);
    pointer-events: none;
  }

  .shop-ai-pill-btn{
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(91, 77, 255, 0.3);
    transition: all 0.2s ease;
    border: none;
    background: var(--ai-gradient);
    color: white;
    letter-spacing: 0.3px;
  }
  
  .shop-ai-pill-btn svg{
    width: 18px;
    height: 18px;
  }
  
  .shop-ai-pill-btn:hover{
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 25px rgba(91, 77, 255, 0.4);
  }

  /* ============================================
     BACKDROP & MODAL
     ============================================ */
  .shop-ai-backdrop{
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(4px);
    z-index: 999998;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }
  
  body.shop-ai-open .shop-ai-backdrop{
    opacity: 1;
    visibility: visible;
  }

  .shop-ai-modal{
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -45%) scale(0.96);
    width: 90%;
    max-width: 640px;
    height: 80vh;
    max-height: 800px;
    min-height: 500px;
    background: var(--ai-bg);
    border-radius: var(--ai-radius-lg);
    box-shadow: var(--ai-shadow-lg);
    z-index: 999999;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  body.shop-ai-open .shop-ai-modal{
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  /* ============================================
     HEADER - PURPLE GRADIENT CENTERED
     ============================================ */
  .shop-ai-header{
    position: relative;
    padding: 20px 24px;
    background: var(--ai-gradient);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 64px;
  }

  .shop-ai-header-content{
    display: flex;
    align-items: center;
    gap: 10px;
    color: white;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.3px;
  }

  .shop-ai-header-content svg{
    width: 20px;
    height: 20px;
    opacity: 0.9;
  }

  /* Close button - floating circle */
  .shop-ai-close-btn{
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    opacity: 0;
    pointer-events: none;
    backdrop-filter: blur(4px);
  }

  .shop-ai-close-btn.visible{
    opacity: 1;
    pointer-events: auto;
  }

  .shop-ai-close-btn:hover{
    background: rgba(255, 255, 255, 0.25);
    transform: translate(-50%, -50%) scale(1.05);
  }

  .shop-ai-close-btn svg{
    width: 20px;
    height: 20px;
  }

  /* ============================================
     MESSAGES AREA
     ============================================ */
  .shop-ai-messages{
    flex: 1;
    overflow-y: auto;
    padding: 0;
    display: flex;
    flex-direction: column;
    background: #F9FAFB;
    scroll-behavior: smooth;
    position: relative;
  }

  .shop-ai-messages::-webkit-scrollbar{
    width: 6px;
  }

  .shop-ai-messages::-webkit-scrollbar-thumb{
    background: rgba(0,0,0,0.1);
    border-radius: 3px;
  }

  /* ============================================
     SUGGESTIONS PANEL
     ============================================ */
  .shop-ai-suggestions{
    padding: 24px;
    background: white;
    border-bottom: 1px solid var(--ai-border);
    animation: slideDown 0.4s ease;
  }

  @keyframes slideDown{
    from{
      opacity: 0;
      transform: translateY(-10px);
    }
    to{
      opacity: 1;
      transform: translateY(0);
    }
  }

  .shop-ai-suggestions.hidden{
    display: none;
  }

  .shop-ai-sugg-section{
    margin-bottom: 20px;
  }

  .shop-ai-sugg-section:last-child{
    margin-bottom: 0;
  }

  .shop-ai-sugg-label{
    font-size: 12px;
    font-weight: 600;
    color: var(--ai-text-light);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
  }

  .shop-ai-sugg-list{
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .shop-ai-sugg-item{
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 10px;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 14px;
    font-weight: 500;
    color: var(--ai-text);
    text-align: left;
    width: 100%;
  }

  .shop-ai-sugg-item:hover{
    background: #F3F4F6;
  }

  .shop-ai-sugg-item svg{
    width: 18px;
    height: 18px;
    color: var(--ai-text-light);
    flex-shrink: 0;
  }

  /* Quick Actions - Pill buttons */
  .shop-ai-quick-actions{
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .shop-ai-quick-pill{
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    background: white;
    border: 1px solid var(--ai-border);
    font-size: 13px;
    font-weight: 500;
    color: var(--ai-text);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .shop-ai-quick-pill:hover{
    border-color: var(--ai-primary);
    background: rgba(91, 77, 255, 0.05);
  }

  .shop-ai-quick-pill svg{
    width: 14px;
    height: 14px;
    color: var(--ai-primary);
  }

  .shop-ai-quick-pill.primary{
    background: var(--ai-gradient);
    color: white;
    border: none;
  }

  .shop-ai-quick-pill.primary svg{
    color: white;
  }

  /* ============================================
     CHAT MESSAGES
     ============================================ */
  .shop-ai-message{
    padding: 16px 24px;
    animation: messageIn 0.3s ease;
  }

  @keyframes messageIn{
    from{
      opacity: 0;
      transform: translateY(10px);
    }
    to{
      opacity: 1;
      transform: translateY(0);
    }
  }

  .shop-ai-message.user{
    background: white;
    border-bottom: 1px solid var(--ai-border);
  }

  .shop-ai-message.assistant{
    background: white;
    border-bottom: 1px solid var(--ai-border);
  }

  .shop-ai-message-content{
    max-width: 100%;
  }

  .shop-ai-message-header{
    font-size: 16px;
    font-weight: 600;
    color: var(--ai-text);
    margin-bottom: 8px;
    line-height: 1.4;
  }

  .shop-ai-message-text{
    font-size: 15px;
    line-height: 1.6;
    color: var(--ai-text);
  }

  .shop-ai-message-text p{
    margin: 0 0 12px 0;
  }

  .shop-ai-message-text p:last-child{
    margin-bottom: 0;
  }

  .shop-ai-message-text a{
    color: var(--ai-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .shop-ai-message-text a:hover{
    text-decoration: underline;
  }

  /* ============================================
     PRODUCT CAROUSEL
     ============================================ */
  .shop-ai-product-section{
    margin-top: 16px;
  }

  .shop-ai-product-header{
    font-size: 14px;
    font-weight: 600;
    color: var(--ai-text);
    margin-bottom: 4px;
  }

  .shop-ai-product-subheader{
    font-size: 13px;
    color: var(--ai-text-light);
    margin-bottom: 16px;
  }

  .shop-ai-product-carousel{
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 8px;
    margin-right: -24px;
    padding-right: 24px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .shop-ai-product-carousel::-webkit-scrollbar{
    display: none;
  }

  .shop-ai-product-card{
    flex: 0 0 160px;
    background: white;
    border-radius: 12px;
    border: 1px solid var(--ai-border);
    overflow: hidden;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .shop-ai-product-card:hover{
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    border-color: var(--ai-primary);
  }

  .shop-ai-product-image{
    width: 100%;
    height: 140px;
    background: #F3F4F6;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .shop-ai-product-image img{
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop-ai-product-info{
    padding: 12px;
  }

  .shop-ai-product-title{
    font-size: 13px;
    font-weight: 600;
    color: var(--ai-text);
    margin-bottom: 4px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .shop-ai-product-price{
    font-size: 14px;
    font-weight: 700;
    color: var(--ai-text);
  }

  /* ============================================
     PRODUCT DETAIL MODAL (INLINE)
     ============================================ */
  .shop-ai-product-modal-overlay{
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(8px);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .shop-ai-product-modal-overlay.active{
    opacity: 1;
    visibility: visible;
  }

  .shop-ai-product-modal{
    width: 100%;
    max-width: 520px;
    background: white;
    border-radius: var(--ai-radius-lg);
    box-shadow: var(--ai-shadow-lg);
    display: flex;
    gap: 0;
    overflow: hidden;
    position: relative;
    animation: modalPop 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalPop{
    from{
      opacity: 0;
      transform: scale(0.9) translateY(20px);
    }
    to{
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .shop-ai-product-modal-close{
    position: absolute;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255,255,255,0.9);
    border: 1px solid var(--ai-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  .shop-ai-product-modal-close:hover{
    background: white;
    transform: translateX(-50%) scale(1.05);
  }

  .shop-ai-product-modal-close svg{
    width: 18px;
    height: 18px;
    color: var(--ai-text);
  }

  .shop-ai-product-modal-left{
    flex: 0 0 45%;
    background: #F9FAFB;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .shop-ai-product-modal-left img{
    max-width: 100%;
    max-height: 280px;
    object-fit: contain;
  }

  .shop-ai-product-modal-right{
    flex: 1;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .shop-ai-product-modal-title{
    font-size: 18px;
    font-weight: 700;
    color: var(--ai-text);
    line-height: 1.3;
  }

  .shop-ai-product-modal-price{
    font-size: 20px;
    font-weight: 700;
    color: var(--ai-text);
  }

  .shop-ai-product-modal-options{
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .shop-ai-option-row{
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px;
    border: 1px solid var(--ai-border);
    border-radius: 8px;
    font-size: 14px;
  }

  .shop-ai-option-label{
    font-weight: 600;
    color: var(--ai-text);
  }

  .shop-ai-option-value{
    color: var(--ai-text-light);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .shop-ai-product-modal-description{
    font-size: 14px;
    line-height: 1.5;
    color: var(--ai-text-light);
  }

  .shop-ai-product-modal-actions{
    display: flex;
    gap: 12px;
    margin-top: auto;
  }

  .shop-ai-btn{
    flex: 1;
    padding: 12px 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: none;
  }

  .shop-ai-btn-primary{
    background: var(--ai-gradient);
    color: white;
  }

  .shop-ai-btn-primary:hover{
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(91, 77, 255, 0.3);
  }

  .shop-ai-btn-primary.success{
    background: #10B981;
  }

  .shop-ai-btn-secondary{
    background: white;
    color: var(--ai-text);
    border: 1px solid var(--ai-border);
  }

  .shop-ai-btn-secondary:hover{
    background: #F9FAFB;
  }

  /* ============================================
     THINKING UI - THREE STAGE DOTS
     ============================================ */
  .shop-ai-thinking{
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    background: white;
    border-bottom: 1px solid var(--ai-border);
  }

  .shop-ai-thinking-dots{
    display: flex;
    gap: 6px;
  }

  .shop-ai-thinking-dot{
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ai-border);
    animation: thinkingDot 1.4s infinite ease-in-out both;
  }

  .shop-ai-thinking-dot:nth-child(1){
    animation-delay: -0.32s;
  }

  .shop-ai-thinking-dot:nth-child(2){
    animation-delay: -0.16s;
  }

  @keyframes thinkingDot{
    0%, 80%, 100%{
      transform: scale(0.6);
      opacity: 0.4;
    }
    40%{
      transform: scale(1);
      opacity: 1;
      background: var(--ai-primary);
    }
  }

  .shop-ai-thinking-text{
    font-size: 14px;
    color: var(--ai-text-light);
    font-weight: 500;
  }

  /* ============================================
     INPUT AREA
     ============================================ */
  .shop-ai-input-container{
    padding: 16px 24px 24px;
    background: white;
    border-top: 1px solid var(--ai-border);
  }

  .shop-ai-input-wrapper{
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 4px 4px 16px;
    background: #F9FAFB;
    border: 1px solid var(--ai-border);
    border-radius: 999px;
    transition: all 0.2s ease;
  }

  .shop-ai-input-wrapper:focus-within{
    border-color: var(--ai-primary);
    background: white;
    box-shadow: 0 0 0 3px rgba(91, 77, 255, 0.1);
  }

  .shop-ai-input{
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 15px;
    color: var(--ai-text);
    padding: 12px 0;
    resize: none;
    font-family: var(--ai-font);
    max-height: 100px;
  }

  .shop-ai-input::placeholder{
    color: #9CA3AF;
  }

  .shop-ai-input-actions{
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .shop-ai-mic-btn,
  .shop-ai-send-btn{
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .shop-ai-mic-btn{
    background: transparent;
    color: var(--ai-text-light);
  }

  .shop-ai-mic-btn:hover{
    background: rgba(0,0,0,0.05);
    color: var(--ai-text);
  }

  .shop-ai-send-btn{
    background: var(--ai-gradient);
    color: white;
    opacity: 0.5;
    pointer-events: none;
  }

  .shop-ai-send-btn.active{
    opacity: 1;
    pointer-events: auto;
  }

  .shop-ai-send-btn:hover{
    transform: scale(1.05);
  }

  .shop-ai-send-btn svg,
  .shop-ai-mic-btn svg{
    width: 18px;
    height: 18px;
  }

  /* Back button in input */
  .shop-ai-back-btn-small{
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--ai-border);
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--ai-text-light);
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .shop-ai-back-btn-small:hover{
    background: #F3F4F6;
    color: var(--ai-text);
  }

  .shop-ai-back-btn-small svg{
    width: 16px;
    height: 16px;
  }

  /* ============================================
     HISTORY PANEL
     ============================================ */
  .shop-ai-history-panel{
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background: white;
    z-index: 50;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .shop-ai-history-panel.active{
    transform: translateX(0);
  }

  .shop-ai-history-header{
    padding: 20px 24px;
    border-bottom: 1px solid var(--ai-border);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .shop-ai-history-header h3{
    font-size: 18px;
    font-weight: 700;
    margin: 0;
  }

  .shop-ai-history-list{
    flex: 1;
    overflow-y: auto;
    padding: 16px;
  }

  .shop-ai-history-item{
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-bottom: 8px;
  }

  .shop-ai-history-item:hover{
    background: #F9FAFB;
  }

  .shop-ai-history-content{
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
  }

  .shop-ai-history-icon{
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--ai-gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    flex-shrink: 0;
  }

  .shop-ai-history-icon svg{
    width: 20px;
    height: 20px;
  }

  .shop-ai-history-text{
    flex: 1;
  }

  .shop-ai-history-title{
    font-size: 15px;
    font-weight: 600;
    color: var(--ai-text);
    margin-bottom: 4px;
  }

  .shop-ai-history-time{
    font-size: 13px;
    color: var(--ai-text-light);
  }

  .shop-ai-history-arrow{
    color: var(--ai-text-light);
  }

  /* ============================================
     MOBILE RESPONSIVE
     ============================================ */
  @media (max-width: 640px){
    .shop-ai-modal{
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      border-radius: 0;
      top: 0;
      left: 0;
      transform: translateY(100%);
    }

    body.shop-ai-open .shop-ai-modal{
      transform: translateY(0);
    }

    .shop-ai-floating-group{
      bottom: 16px;
      right: 16px;
    }

    .shop-ai-product-modal{
      flex-direction: column;
      max-height: 90vh;
      overflow-y: auto;
    }

    .shop-ai-product-modal-left{
      flex: 0 0 auto;
      height: 240px;
    }

    .shop-ai-product-modal-right{
      padding: 20px;
    }
  }

  /* Feedback buttons */
  .shop-ai-feedback{
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .shop-ai-feedback-btn{
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--ai-border);
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--ai-text-light);
    transition: all 0.2s ease;
  }

  .shop-ai-feedback-btn:hover{
    background: #F9FAFB;
    color: var(--ai-text);
  }

  .shop-ai-feedback-btn svg{
    width: 16px;
    height: 16px;
  }
</style>

<div class="shop-ai-reset" aria-hidden="false">
  <!-- Floating Launcher -->
  <div class="shop-ai-floating-group" id="shop-ai-floating-group">
    <button class="shop-ai-pill-btn" data-trigger="chat" aria-label="Ask our AI">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .962L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"/>
      </svg>
      Ask our AI
    </button>
  </div>

  <!-- Backdrop -->
  <div class="shop-ai-backdrop" id="shop-ai-backdrop"></div>

  <!-- Main Modal -->
  <div class="shop-ai-modal" id="shop-ai-modal" role="dialog" aria-modal="true" aria-label="AI Assistant">
    <!-- Header -->
    <div class="shop-ai-header">
      <div class="shop-ai-header-content">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .962L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"/>
        </svg>
        Hi, how can I help you?
      </div>
      <button class="shop-ai-close-btn" id="shop-ai-close-btn" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Messages Area -->
    <div class="shop-ai-messages" id="shop-ai-messages">
      <!-- Suggestions Panel -->
      <div class="shop-ai-suggestions visible" id="shop-ai-suggestions">
        <div class="shop-ai-sugg-section">
          <div class="shop-ai-sugg-label">Suggestions</div>
          <div class="shop-ai-sugg-list">
            <button class="shop-ai-sugg-item" onclick="ShopAIChat.send('Where can I find ski wax')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
              Where can I find ski wax
            </button>
            <button class="shop-ai-sugg-item" onclick="ShopAIChat.send('What are the details of data usage')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
              What are the details of data usage
            </button>
            <button class="shop-ai-sugg-item" onclick="ShopAIChat.send('Find snowboards that are currently in stock')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
              Find snowboards that are currently in stock
            </button>
          </div>
        </div>

        <div class="shop-ai-sugg-section">
          <div class="shop-ai-sugg-label">Quick Actions</div>
          <div class="shop-ai-quick-actions">
            <button class="shop-ai-quick-pill primary" onclick="ShopAIChat.send('Help me choose')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .962L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"/>
              </svg>
              Help me choose
            </button>
            <button class="shop-ai-quick-pill" onclick="ShopAIChat.send('Track my order')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
              Track my order
            </button>
            <button class="shop-ai-quick-pill" onclick="ShopAIChat.openHistory()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
              Previous chats
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Input Area -->
    <div class="shop-ai-input-container">
      <div class="shop-ai-input-wrapper">
        <button class="shop-ai-back-btn-small" id="shop-ai-back-btn" style="display: none;" aria-label="Back">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15,18 9,12 15,6"></polyline>
          </svg>
        </button>
        <textarea 
          class="shop-ai-input" 
          id="shop-ai-input" 
          placeholder="Ask me anything..."
          rows="1"
        ></textarea>
        <div class="shop-ai-input-actions">
          <button class="shop-ai-mic-btn" aria-label="Voice input">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
              <line x1="12" y1="19" x2="12" y2="23"></line>
              <line x1="8" y1="23" x2="16" y2="23"></line>
            </svg>
          </button>
          <button class="shop-ai-send-btn" id="shop-ai-send-btn" aria-label="Send">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- History Panel -->
    <div class="shop-ai-history-panel" id="shop-ai-history-panel">
      <div class="shop-ai-history-header">
        <button class="shop-ai-back-btn-small" onclick="ShopAIChat.closeHistory()" aria-label="Back">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15,18 9,12 15,6"></polyline>
          </svg>
        </button>
        <h3>Previous Chats</h3>
      </div>
      <div class="shop-ai-history-list" id="shop-ai-history-list">
        <!-- Populated by JS -->
      </div>
    </div>
  </div>
</div>

<script src="{{ 'chat.js' | asset_url }}" defer></script>

<script>
  window.shopChatConfig = {
    apiUrl: '{{ shop.url }}/apps/shop-chat/chat',
    leadsUrl: '{{ shop.url }}/apps/shop-chat/leads',
    shopId: '{{ shop.id }}',
    cartUrl: '{{ shop.url }}/apps/shop-chat/api/cart',
    promptType: 'creativeAutomationAssistant',
    welcomeMessage: '{{ settings.welcome_message }}'
  };
</script>

{% schema %}
{
  "name": "AI Chat Assistant",
  "target": "body",
  "settings": [
    {"type":"text","id":"chat_title","label":"Chat Title","default":"AI Assistant"},
    {"type":"text","id":"welcome_message","label":"Welcome Message","default":"Hi! How can I help you today?"}
  ]
}
{% endschema %}
