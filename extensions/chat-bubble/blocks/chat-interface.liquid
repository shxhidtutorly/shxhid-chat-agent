<script>
  (function() {
    var backend = '{{ block.settings.backend_url | default: "" }}';
    if (backend && backend !== 'https://shxhid-chat-agent-production.up.railway.app') {
      window.shopChatConfig = {
        apiUrl: backend + '/chat',
        leadsUrl: backend + '/leads',
        cartUrl: backend + '/api/cart',
        shopDomain: '{{ shop.permanent_domain }}',
        shopId: '{{ shop.id }}',
        promptType: 'creativeAutomationAssistant',
        welcomeMessage: '{{ block.settings.welcome_message }}'
      };
    } else {
      window.shopChatConfig = {
        apiUrl: '/apps/shop-chat/chat',
        leadsUrl: '/apps/shop-chat/leads',
        cartUrl: '/apps/shop-chat/api/cart',
        shopDomain: '{{ shop.permanent_domain }}',
        shopId: '{{ shop.id }}',
        promptType: 'creativeAutomationAssistant',
        welcomeMessage: '{{ block.settings.welcome_message }}'
      };
    }
  })();
</script>

<!-- ============================================
     HEADER BUTTON INJECTION
     Finds the Shopify theme header icon area and
     inserts an "Ask AI" pill button next to search/cart.
     Works with Dawn-based themes (header__icons).
     ============================================ -->
<script>
(function(){
  'use strict';

  var BUTTON_HTML =
    '<div class="shop-ai-header-trigger-wrap" id="shop-ai-header-btn-wrap">' +
      '<button class="shop-ai-header-trigger" id="shop-ai-header-btn" aria-label="Ask AI Assistant" type="button">' +
        '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L13.5 8.5L20 10L13.5 11.5L12 18L10.5 11.5L4 10L10.5 8.5L12 2Z"/></svg>' +
        '<span class="shop-ai-trigger-label">Ask AI</span>' +
      '</button>' +
    '</div>';

  function injectHeaderButton() {
    // Don't inject twice
    if (document.getElementById('shop-ai-header-btn-wrap')) return true;

    // Strategy 1: Dawn theme — look for .header__icons (the container with search, cart, account icons)
    var iconContainers = document.querySelectorAll('.header__icons, .header__icon--menu, header-drawer');
    var target = null;

    // Prefer .header__icons (the rightmost icon group in Dawn headers)
    var headerIcons = document.querySelector('.header__icons');
    if (headerIcons) {
      // Insert as the FIRST child so it appears before search/cart
      headerIcons.insertAdjacentHTML('afterbegin', BUTTON_HTML);
      bindBtn();
      return true;
    }

    // Strategy 2: Look for any header nav/icon area
    var headerRight = document.querySelector(
      'header .header__icon, ' +
      'header .site-header__icons, ' +
      'header .header-icons, ' +
      'header .header__buttons, ' +
      '.header__heading-link ~ *'
    );
    if (headerRight && headerRight.parentElement) {
      headerRight.parentElement.insertAdjacentHTML('afterbegin', BUTTON_HTML);
      bindBtn();
      return true;
    }

    // Strategy 3: Generic — find the first <header> tag and append inside
    var headerEl = document.querySelector('header') || document.querySelector('[role="banner"]');
    if (headerEl) {
      // Find the inner wrapper (often .header or .header__wrapper)
      var inner = headerEl.querySelector('.header, .header__wrapper, .site-header__wrapper');
      if (inner) {
        inner.insertAdjacentHTML('beforeend', BUTTON_HTML);
      } else {
        headerEl.insertAdjacentHTML('beforeend', BUTTON_HTML);
      }
      bindBtn();
      return true;
    }

    return false; // header not found yet
  }

  function bindBtn() {
    var btn = document.getElementById('shop-ai-header-btn');
    if (!btn) return;
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      // Use ShopAIChat if available, otherwise toggle body class directly
      if (window.ShopAIChat && typeof window.ShopAIChat.open === 'function') {
        window.ShopAIChat.open();
      } else {
        document.body.classList.add('shop-ai-open');
      }
    });
  }

  // Try immediately
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      if (!injectHeaderButton()) {
        // Retry a few times for lazy-loaded headers
        var tries = 0;
        var retryInterval = setInterval(function() {
          tries++;
          if (injectHeaderButton() || tries > 20) {
            clearInterval(retryInterval);
          }
        }, 250);
      }
    });
  } else {
    if (!injectHeaderButton()) {
      var tries = 0;
      var retryInterval = setInterval(function() {
        tries++;
        if (injectHeaderButton() || tries > 20) {
          clearInterval(retryInterval);
        }
      }, 250);
    }
  }
})();
</script>

