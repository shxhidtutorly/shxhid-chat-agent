<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<style>
  /* ============================================
     MODERN THEME - BLACK, WHITE, LIGHT ORANGE
     ============================================ */
  :root{
    --shop-ai-primary: #FF9D5C;
    --shop-ai-primary-dark: #FF8534;
    --shop-ai-gradient: linear-gradient(135deg, #FF9D5C 0%, #FF8534 100%);
    --shop-ai-bg: #ffffff;
    --shop-ai-text: #1a1a1a;
    --shop-ai-text-light: #666666;
    --shop-ai-border: rgba(0,0,0,0.08);
    --shop-ai-glass: rgba(255,255,255,0.8);
    --shop-ai-shadow: 0 20px 60px rgba(0,0,0,0.12);
    --shop-ai-shadow-sm: 0 4px 12px rgba(0,0,0,0.06);
    --shop-ai-radius: 24px;
    --shop-ai-font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .shop-ai-reset *{
    box-sizing: border-box;
    font-family: var(--shop-ai-font);
    -webkit-font-smoothing: antialiased;
  }

  /* ============================================
     FLOATING LAUNCHER
     ============================================ */
  .shop-ai-floating-group{
    position: fixed;
    bottom: 24px;
    right: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    z-index: 999990;
    transition: transform 0.3s ease, opacity 0.25s ease;
  }
  
  .shop-ai-floating-group.hidden{
    transform: translateY(20px);
    opacity: 0;
    pointer-events: none;
  }

  .shop-ai-pill-btn{
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: var(--shop-ai-shadow-sm);
    transition: all 0.2s ease;
    border: none;
    background: white;
  }
  
  .shop-ai-pill-btn svg{
    width: 20px;
    height: 20px;
  }
  
  .shop-ai-pill-btn:hover{
    transform: translateY(-3px);
    box-shadow: var(--shop-ai-shadow);
  }

  .shop-ai-btn-primary{
    background: var(--shop-ai-gradient);
    color: #fff;
  }
  
  .shop-ai-btn-secondary{
    background: #fff;
    color: var(--shop-ai-text);
    border: 1px solid var(--shop-ai-border);
  }

  /* ============================================
     BACKDROP & MODAL
     ============================================ */
  .shop-ai-backdrop{
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    z-index: 999998;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }
  
  body.shop-ai-open .shop-ai-backdrop{
    opacity: 1;
    visibility: visible;
  }

  .shop-ai-modal{
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -48%) scale(0.95);
    width: 92%;
    max-width: 720px;
    height: 75vh;
    max-height: 90vh;
    background: #ffffff;
    border-radius: var(--shop-ai-radius);
    box-shadow: var(--shop-ai-shadow);
    z-index: 999999;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid var(--shop-ai-border);
  }

  body.shop-ai-open .shop-ai-modal{
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  /* ============================================
     HEADER - TRANSLUCENT TEXT ON BORDER
     ============================================ */
  .shop-ai-header{
    position: relative;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100px;
    border-bottom: 1px solid transparent;
    background: linear-gradient(180deg, rgba(255,157,92,0.03) 0%, rgba(255,255,255,0) 100%);
  }
  
  .shop-ai-header::before{
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%, 
      rgba(255,157,92,0.3) 20%, 
      rgba(255,133,52,0.5) 50%, 
      rgba(255,157,92,0.3) 80%, 
      transparent 100%);
    opacity: 0.8;
  }

  .shop-ai-header h3{
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    background: linear-gradient(135deg, #FF9D5C 0%, #FF8534 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
    z-index: 2;
    letter-spacing: -0.5px;
  }

  /* Header actions - minimalist 3-dot menu */
  .shop-ai-header-actions{
    position: absolute;
    right: 20px;
    top: 20px;
    display: flex;
    gap: 8px;
    z-index: 10;
  }
  
  .shop-ai-icon-btn{
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.04);
    border: 1px solid var(--shop-ai-border);
    color: var(--shop-ai-text);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .shop-ai-icon-btn:hover{
    background: rgba(255,157,92,0.1);
    transform: translateY(-2px);
  }

  .shop-ai-menu-btn{
    position: relative;
  }
  
  .shop-ai-menu-btn svg{
    width: 4px;
    height: 4px;
  }
  
  /* 3-dot icon */
  .shop-ai-3dot-icon{
    display: flex;
    flex-direction: column;
    gap: 3px;
    align-items: center;
  }
  
  .shop-ai-3dot-icon span{
    width: 4px;
    height: 4px;
    background: var(--shop-ai-text);
    border-radius: 50%;
    opacity: 0.6;
  }

  /* Dropdown menu */
  .shop-ai-menu-dropdown{
    position: absolute;
    top: 48px;
    right: 0;
    background: white;
    border: 1px solid var(--shop-ai-border);
    border-radius: 12px;
    box-shadow: var(--shop-ai-shadow);
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.25s ease;
    overflow: hidden;
    z-index: 1000;
  }
  
  .shop-ai-menu-dropdown.active{
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  
  .shop-ai-menu-item{
    width: 100%;
    padding: 14px 18px;
    border: none;
    background: transparent;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
    color: var(--shop-ai-text);
    cursor: pointer;
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .shop-ai-menu-item:hover{
    background: rgba(255,157,92,0.08);
  }
  
  .shop-ai-menu-item.danger{
    color: #ef4444;
  }

  /* ============================================
     MESSAGES AREA
     ============================================ */
  .shop-ai-messages{
    flex: 1;
    overflow-y: auto;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: transparent;
    scroll-behavior: smooth;
  }

  .shop-ai-message{
    display: flex;
    flex-direction: column;
    animation: messageSlide 0.3s ease;
  }
  
  @keyframes messageSlide{
    from{
      opacity: 0;
      transform: translateY(10px);
    }
    to{
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* User message - clean text, no bubble */
  .shop-ai-message.user{
    align-self: flex-end;
    max-width: 75%;
  }
  
  .shop-ai-message.user .shop-ai-bubble{
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
    color: var(--shop-ai-text);
    font-size: 15px;
    font-weight: 500;
    text-align: right;
  }

  /* Assistant message - light bubble */
  .shop-ai-message.assistant{
    align-self: flex-start;
    max-width: 85%;
  }
  
  .shop-ai-message.assistant .shop-ai-bubble{
    padding: 16px 18px;
    background: rgba(0,0,0,0.02);
    border: 1px solid var(--shop-ai-border);
    border-radius: 18px;
    border-top-left-radius: 4px;
    color: var(--shop-ai-text);
    font-size: 15px;
    line-height: 1.6;
  }

  /* Clean markdown formatting */
  .shop-ai-bubble p{
    margin: 0 0 12px 0;
  }
  
  .shop-ai-bubble p:last-child{
    margin-bottom: 0;
  }
  
  .shop-ai-bubble strong{
    font-weight: 600;
    color: var(--shop-ai-text);
  }
  
  .shop-ai-bubble a{
    color: var(--shop-ai-primary);
    text-decoration: none;
  }

  /* ============================================
     SUGGESTIONS - INDUSTRIAL PRODUCTS
     ============================================ */
  .shop-ai-suggestions{
    display: block;
    margin-top: auto;
    opacity: 0;
    animation: fadeIn 0.5s ease forwards;
    animation-delay: 0.2s;
  }
  
  @keyframes fadeIn{
    to{
      opacity: 1;
    }
  }
  
  .shop-ai-suggestions.visible{
    opacity: 1;
  }
  
  .shop-ai-sugg-title{
    font-size: 12px;
    text-transform: uppercase;
    color: var(--shop-ai-text-light);
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 14px;
  }
  
  .shop-ai-sugg-list{
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  
  .shop-ai-sugg-item{
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 12px;
    background: white;
    border: 1px solid var(--shop-ai-border);
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 14px;
    font-weight: 500;
    color: var(--shop-ai-text);
  }
  
  .shop-ai-sugg-item svg{
    width: 18px;
    height: 18px;
    color: var(--shop-ai-primary);
    flex-shrink: 0;
  }
  
  .shop-ai-sugg-item:hover{
    transform: translateX(6px);
    border-color: var(--shop-ai-primary);
    box-shadow: var(--shop-ai-shadow-sm);
  }

  /* ============================================
     PRODUCT DISPLAY - ROW LAYOUT
     ============================================ */
  .shop-ai-product-container{
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: fadeInUp 0.4s ease;
  }
  
  @keyframes fadeInUp{
    from{
      opacity: 0;
      transform: translateY(20px);
    }
    to{
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .shop-ai-product-row{
    display: flex;
    gap: 16px;
    background: white;
    border: 1px solid var(--shop-ai-border);
    border-radius: 14px;
    padding: 14px;
    align-items: center;
    transition: all 0.25s ease;
    cursor: pointer;
  }
  
  .shop-ai-product-row:hover{
    transform: translateY(-4px);
    box-shadow: var(--shop-ai-shadow);
    border-color: var(--shop-ai-primary);
  }
  
  .shop-ai-prod-img{
    width: 90px;
    height: 90px;
    border-radius: 10px;
    object-fit: cover;
    background: #f5f5f5;
    flex-shrink: 0;
  }
  
  .shop-ai-prod-info{
    flex: 1;
    min-width: 0;
  }
  
  .shop-ai-prod-title{
    font-size: 15px;
    font-weight: 700;
    color: var(--shop-ai-text);
    margin-bottom: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .shop-ai-prod-price{
    font-size: 14px;
    color: var(--shop-ai-primary);
    font-weight: 600;
    margin-bottom: 10px;
  }
  
  .shop-ai-prod-actions{
    display: flex;
    gap: 10px;
  }
  
  .shop-ai-prod-btn{
    background: var(--shop-ai-gradient);
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .shop-ai-prod-btn:hover{
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255,157,92,0.3);
  }
  
  .shop-ai-prod-btn-view{
    background: transparent;
    color: var(--shop-ai-text);
    border: 1px solid var(--shop-ai-border);
  }

  /* ============================================
     THINKING UI - MODERN GLASSY
     ============================================ */
  .shop-ai-thinking-container{
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: rgba(255,255,255,0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,157,92,0.2);
    border-radius: 16px;
    animation: thinkingPulse 2s ease infinite;
  }
  
  @keyframes thinkingPulse{
    0%, 100%{
      box-shadow: 0 0 0 0 rgba(255,157,92,0.4);
    }
    50%{
      box-shadow: 0 0 0 8px rgba(255,157,92,0);
    }
  }
  
  .shop-ai-thinking-stages{
    display: flex;
    gap: 8px;
    align-items: center;
  }
  
  .shop-ai-stage{
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(0,0,0,0.1);
    transition: all 0.3s ease;
  }
  
  .shop-ai-stage.active{
    background: var(--shop-ai-gradient);
    animation: stagePulse 1s ease infinite;
  }
  
  @keyframes stagePulse{
    0%, 100%{
      transform: scale(1);
    }
    50%{
      transform: scale(1.3);
    }
  }
  
  .shop-ai-thinking-text{
    font-size: 14px;
    font-weight: 500;
    color: var(--shop-ai-text-light);
  }

  /* ============================================
     INPUT AREA - CHATGPT STYLE
     ============================================ */
  .shop-ai-input-area{
    padding: 20px 24px;
    border-top: 1px solid var(--shop-ai-border);
    background: white;
  }
  
  .shop-ai-input-wrapper{
    display: flex;
    align-items: flex-end;
    gap: 12px;
    padding: 12px 16px;
    background: white;
    border: 2px solid var(--shop-ai-border);
    border-radius: 16px;
    transition: all 0.2s ease;
  }
  
  .shop-ai-input-wrapper:focus-within{
    border-color: var(--shop-ai-primary);
    box-shadow: 0 0 0 3px rgba(255,157,92,0.1);
  }
  
  .shop-ai-textarea{
    flex: 1;
    border: none;
    outline: none;
    resize: none;
    font-size: 15px;
    line-height: 1.5;
    color: var(--shop-ai-text);
    font-family: var(--shop-ai-font);
    max-height: 120px;
    background: transparent;
  }
  
  .shop-ai-textarea::placeholder{
    color: var(--shop-ai-text-light);
    opacity: 0.6;
  }
  
  .shop-ai-send-btn{
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--shop-ai-gradient);
    border: none;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    opacity: 0.5;
    pointer-events: none;
  }
  
  .shop-ai-send-btn.active{
    opacity: 1;
    pointer-events: auto;
  }
  
  .shop-ai-send-btn:hover{
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255,157,92,0.4);
  }
  
  .shop-ai-send-btn svg{
    width: 18px;
    height: 18px;
  }

  /* ============================================
     EMAIL CAPTURE POPUP
     ============================================ */
  .shop-ai-email-overlay{
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }
  
  .shop-ai-email-overlay.active{
    opacity: 1;
    visibility: visible;
  }
  
  .shop-ai-email-popup{
    background: white;
    border-radius: 20px;
    padding: 36px 32px;
    max-width: 420px;
    width: 90%;
    box-shadow: var(--shop-ai-shadow);
    animation: popupSlide 0.4s ease;
    text-align: center;
  }
  
  @keyframes popupSlide{
    from{
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to{
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  
  .shop-ai-email-icon{
    width: 64px;
    height: 64px;
    margin: 0 auto 20px;
    background: var(--shop-ai-gradient);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .shop-ai-email-icon svg{
    width: 32px;
    height: 32px;
    color: white;
  }
  
  .shop-ai-email-title{
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 10px 0;
    color: var(--shop-ai-text);
  }
  
  .shop-ai-email-subtitle{
    font-size: 15px;
    color: var(--shop-ai-text-light);
    margin: 0 0 24px 0;
  }
  
  .shop-ai-email-input-wrapper{
    position: relative;
    margin-bottom: 16px;
  }
  
  .shop-ai-email-input{
    width: 100%;
    padding: 14px 18px;
    border: 2px solid var(--shop-ai-border);
    border-radius: 12px;
    font-size: 15px;
    outline: none;
    transition: all 0.2s ease;
  }
  
  .shop-ai-email-input:focus{
    border-color: var(--shop-ai-primary);
  }
  
  .shop-ai-email-error{
    color: #ef4444;
    font-size: 13px;
    margin-top: 8px;
    display: none;
  }
  
  .shop-ai-email-error.visible{
    display: block;
  }
  
  .shop-ai-email-submit{
    width: 100%;
    padding: 14px;
    background: var(--shop-ai-gradient);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-bottom: 12px;
  }
  
  .shop-ai-email-submit:hover{
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255,157,92,0.3);
  }
  
  .shop-ai-email-skip{
    background: transparent;
    color: var(--shop-ai-text-light);
    border: none;
    padding: 10px;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .shop-ai-email-skip:hover{
    color: var(--shop-ai-text);
  }

  /* ============================================
     HISTORY PANEL
     ============================================ */
  .shop-ai-history-panel{
    position: absolute;
    inset: 0;
    background: white;
    z-index: 50;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }
  
  .shop-ai-history-panel.active{
    transform: translateX(0);
  }
  
  .shop-ai-history-header{
    padding: 24px;
    border-bottom: 1px solid var(--shop-ai-border);
    display: flex;
    align-items: center;
    gap: 16px;
  }
  
  .shop-ai-history-header h3{
    font-size: 18px;
    font-weight: 700;
    margin: 0;
  }
  
  .shop-ai-back-btn{
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0,0,0,0.04);
    border: 1px solid var(--shop-ai-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .shop-ai-back-btn:hover{
    background: rgba(255,157,92,0.1);
  }
  
  .shop-ai-history-list{
    flex: 1;
    overflow-y: auto;
    padding: 16px;
  }
  
  .shop-ai-history-item{
    padding: 16px;
    border: 1px solid var(--shop-ai-border);
    border-radius: 12px;
    margin-bottom: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .shop-ai-history-item:hover{
    border-color: var(--shop-ai-primary);
    transform: translateX(6px);
  }
  
  .shop-ai-history-item-title{
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--shop-ai-text);
  }
  
  .shop-ai-history-item-time{
    font-size: 13px;
    color: var(--shop-ai-text-light);
  }

  /* ============================================
     MOBILE RESPONSIVE
     ============================================ */
  @media (max-width: 768px){
    .shop-ai-modal{
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      border-radius: 0;
      top: 0;
      left: 0;
      transform: translateY(100%);
    }
    
    body.shop-ai-open .shop-ai-modal{
      transform: translateY(0);
    }
    
    .shop-ai-header{
      padding-top: max(20px, env(safe-area-inset-top));
    }
    
    .shop-ai-product-row{
      flex-direction: column;
      align-items: flex-start;
    }
    
    .shop-ai-prod-img{
      width: 100%;
      height: 180px;
    }
  }
</style>

<div class="shop-ai-reset" aria-hidden="false">
  <div class="shop-ai-floating-group" id="shop-ai-floating-group">
    <button class="shop-ai-pill-btn shop-ai-btn-secondary" data-trigger="chat" aria-label="Chat with AI">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
      </svg>
      Chat with AI
    </button>

    <button class="shop-ai-pill-btn shop-ai-btn-primary" data-trigger="ask" aria-label="Ask AI">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2L13.5 8.5L20 10L13.5 11.5L12 18L10.5 11.5L4 10L10.5 8.5L12 2Z"/>
      </svg>
      Ask AI
    </button>
  </div>

  <div class="shop-ai-backdrop" id="shop-ai-backdrop"></div>

  <div class="shop-ai-modal" id="shop-ai-modal" role="dialog" aria-modal="true" aria-label="AI Assistant">
    <div class="shop-ai-header">
      <h3>Hi, how can I help you?</h3>
      
      <div class="shop-ai-header-actions">
        <button class="shop-ai-icon-btn shop-ai-menu-btn" id="shop-ai-menu-btn" aria-label="Menu">
          <div class="shop-ai-3dot-icon">
            <span></span>
            <span></span>
            <span></span>
          </div>
        </button>
        <button class="shop-ai-icon-btn" id="shop-ai-close-btn" aria-label="Close">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="shop-ai-menu-dropdown" id="shop-ai-menu">
      <button class="shop-ai-menu-item" data-action="new">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
        </svg>
        New chat
      </button>
      <button class="shop-ai-menu-item" data-action="history">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12,6 12,12 16,14"/>
        </svg>
        Previous chats
      </button>
      <button class="shop-ai-menu-item danger" data-action="end">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="15" y1="9" x2="9" y2="15"/>
          <line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
        End chat
      </button>
    </div>

    <div class="shop-ai-email-overlay" id="shop-ai-email-overlay">
      <div class="shop-ai-email-popup">
        <div class="shop-ai-email-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <h3 class="shop-ai-email-title">Stay Connected</h3>
        <p class="shop-ai-email-subtitle">Get exclusive offers and product updates</p>
        <div class="shop-ai-email-input-wrapper">
          <input 
            type="email" 
            class="shop-ai-email-input" 
            id="shop-ai-email-input"
            placeholder="Enter your email..."
            autocomplete="email"
          />
          <p class="shop-ai-email-error" id="shop-ai-email-error">Please enter a valid email</p>
        </div>
        <button class="shop-ai-email-submit" id="shop-ai-email-submit">Continue</button>
        <button class="shop-ai-email-skip" id="shop-ai-email-skip">Skip for now</button>
      </div>
    </div>

    <div class="shop-ai-messages" id="shop-ai-messages">
      <div class="shop-ai-suggestions visible" id="shop-ai-suggestions">
        <div class="shop-ai-sugg-title">How can I assist you?</div>
        <div class="shop-ai-sugg-list">
          <button class="shop-ai-sugg-item" onclick="ShopAIChat.send('Show me circuit breakers for industrial applications')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
            Show me circuit breakers for industrial applications
          </button>

          <button class="shop-ai-sugg-item" onclick="ShopAIChat.send('I need pneumatic components for manufacturing')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
            I need pneumatic components for manufacturing
          </button>

          <button class="shop-ai-sugg-item" onclick="ShopAIChat.send('Help me find the right inverter drive')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
            Help me find the right inverter drive
          </button>

          <button class="shop-ai-sugg-item" onclick="ShopAIChat.send('Do you have SKU: ')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8"/>
            </svg>
            Search by SKU or model number
          </button>
        </div>
      </div>
    </div>

    <div class="shop-ai-input-area">
      <div class="shop-ai-input-wrapper">
        <textarea 
          class="shop-ai-textarea" 
          id="shop-ai-input" 
          placeholder="Ask me anything..."
          rows="1"
        ></textarea>
        <button class="shop-ai-send-btn" id="shop-ai-send-btn" aria-label="Send">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 2L11 13"/>
            <path d="M22 2L15 22L11 13L2 9L22 2Z"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="shop-ai-history-panel" id="shop-ai-history-panel">
      <div class="shop-ai-history-header">
        <button class="shop-ai-back-btn" id="shop-ai-back-btn" aria-label="Back">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15,18 9,12 15,6"/>
          </svg>
        </button>
        <h3>Previous Chats</h3>
      </div>
      <div class="shop-ai-history-list" id="shop-ai-history-list">
        </div>
    </div>
  </div>
</div>

<script src="{{ 'chat.js' | asset_url }}" defer></script>
<script src="{{ 'chat-ui-enhancements.js' | asset_url }}" defer></script>

<script>
  window.shopChatConfig = {
    apiUrl: '{{ shop.url }}/apps/shop-chat/chat',
    leadsUrl: '{{ shop.url }}/apps/shop-chat/leads',
    shopId: '{{ shop.id }}',
    promptType: 'standardAssistant',
    welcomeMessage: '{{ settings.welcome_message }}'
  };
</script>

{% schema %}
{
  "name": "AI Chat Assistant",
  "target": "body",
  "settings": [
    {"type":"text","id":"chat_title","label":"Chat Title","default":"AI Assistant"},
    {"type":"text","id":"welcome_message","label":"Welcome Message","default":"Hi! How can I help you today?"}
  ]
}
{% endschema %}
