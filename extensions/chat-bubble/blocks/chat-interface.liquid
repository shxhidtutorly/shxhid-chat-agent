{% comment %}
  Shopify AI Chat Interface - Modal Overlay Design
  Production-ready implementation matching screenshot requirements
{% endcomment %}

{%- liquid
  assign api_url = block.settings.api_url | default: 'shxhid-chat-agent-production.up.railway.app'
  assign header_text = block.settings.header_text | default: 'Hi, how can I help you?'
  assign primary_color = block.settings.primary_color | default: '#8B7FD8'
-%}

<div id="shop-ai-wrapper">
  <!-- Backdrop Overlay -->
  <div class="shop-ai-backdrop" id="shop-ai-backdrop"></div>

  <!-- Floating Action Buttons -->
  <div class="shop-ai-fab-container" id="shop-ai-fab-container">
    <button class="shop-ai-fab-secondary" onclick="ShopAIChat.open()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
      </svg>
      <span>Chat with our AI</span>
    </button>
    <button class="shop-ai-fab-secondary" onclick="ShopAIChat.open()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>
      </svg>
      <span>Help me choose</span>
    </button>
    <button class="shop-ai-fab-primary" onclick="ShopAIChat.open()">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2L13.5 8.5L20 10L13.5 11.5L12 18L10.5 11.5L4 10L10.5 8.5L12 2Z"/>
      </svg>
      <span>Ask our AI</span>
    </button>
  </div>

  <!-- Chat Modal -->
  <div class="shop-ai-modal" id="shop-ai-modal">
    <!-- Header with Gradient -->
    <div class="shop-ai-modal-header">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2L13.5 8.5L20 10L13.5 11.5L12 18L10.5 11.5L4 10L10.5 8.5L12 2Z"/>
      </svg>
      <h2>{{ header_text }}</h2>
      <button class="shop-ai-close-btn" onclick="ShopAIChat.close()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Messages Container -->
    <div class="shop-ai-messages" id="shop-ai-messages">
      <!-- Messages will be inserted here -->
    </div>

    <!-- Input Area -->
    <div class="shop-ai-input-container">
      <button class="shop-ai-back-btn" onclick="ShopAIChat.showSuggestions()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
      <input 
        type="text" 
        id="shop-ai-input" 
        placeholder="Need more details?"
        onkeypress="if(event.key==='Enter') ShopAIChat.send()"
      />
      <button class="shop-ai-voice-btn" title="Voice input">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
          <path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/>
          <line x1="8" y1="23" x2="16" y2="23"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
/* ===== CSS VARIABLES ===== */
:root {
  --sai-primary: {{ primary_color }};
  --sai-primary-light: #9B8FE8;
  --sai-primary-dark: #6B5FCE;
  --sai-gradient: linear-gradient(135deg, var(--sai-primary) 0%, var(--sai-primary-dark) 100%);
  --sai-white: #ffffff;
  --sai-gray-50: #fafafa;
  --sai-gray-100: #f5f5f5;
  --sai-gray-200: #e5e5e5;
  --sai-gray-400: #a3a3a3;
  --sai-gray-600: #525252;
  --sai-gray-900: #171717;
  --sai-shadow-lg: 0 20px 60px -10px rgba(0, 0, 0, 0.3);
  --sai-shadow-xl: 0 25px 80px -15px rgba(0, 0, 0, 0.4);
  --sai-radius-lg: 16px;
  --sai-radius-xl: 24px;
  --sai-radius-full: 9999px;
}

/* ===== RESET & BASE ===== */
#shop-ai-wrapper * {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

#shop-ai-wrapper {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  position: fixed;
  inset: 0;
  z-index: 999999;
  pointer-events: none;
}

#shop-ai-wrapper > * {
  pointer-events: auto;
}

/* ===== BACKDROP OVERLAY ===== */
.shop-ai-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
  z-index: 999998;
}

.shop-ai-backdrop.active {
  opacity: 1;
  visibility: visible;
}

/* ===== FLOATING ACTION BUTTONS ===== */
.shop-ai-fab-container {
  position: fixed;
  bottom: 24px;
  right: 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  align-items: flex-end;
  z-index: 999999;
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.shop-ai-fab-container.hidden {
  opacity: 0;
  transform: translateY(20px);
  pointer-events: none;
}

.shop-ai-fab-secondary,
.shop-ai-fab-primary {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 24px;
  border: none;
  border-radius: var(--sai-radius-full);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  white-space: nowrap;
}

.shop-ai-fab-secondary {
  background: var(--sai-white);
  color: var(--sai-gray-900);
  border: 1px solid var(--sai-gray-200);
}

.shop-ai-fab-secondary:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 25px rgba(0, 0, 0, 0.2);
  border-color: var(--sai-primary);
}

.shop-ai-fab-primary {
  background: var(--sai-gradient);
  color: white;
  box-shadow: 0 6px 25px rgba(139, 127, 216, 0.4);
}

.shop-ai-fab-primary:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 30px rgba(139, 127, 216, 0.5);
}

/* ===== MODAL ===== */
.shop-ai-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  width: 90%;
  max-width: 680px;
  height: 85vh;
  max-height: 720px;
  background: var(--sai-white);
  border-radius: var(--sai-radius-xl);
  box-shadow: var(--sai-shadow-xl);
  display: flex;
  flex-direction: column;
  opacity: 0;
  visibility: hidden;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 999999;
  overflow: hidden;
}

.shop-ai-modal.active {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, -50%) scale(1);
}

/* ===== HEADER ===== */
.shop-ai-modal-header {
  background: var(--sai-gradient);
  color: white;
  padding: 20px 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  position: relative;
  flex-shrink: 0;
}

.shop-ai-modal-header h2 {
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.shop-ai-close-btn {
  position: absolute;
  right: 20px;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.2);
  border: none;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: white;
  transition: background 0.2s;
}

.shop-ai-close-btn:hover {
  background: rgba(255, 255, 255, 0.3);
}

/* ===== MESSAGES ===== */
.shop-ai-messages {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  scroll-behavior: smooth;
}

.shop-ai-messages::-webkit-scrollbar {
  width: 6px;
}

.shop-ai-messages::-webkit-scrollbar-track {
  background: transparent;
}

.shop-ai-messages::-webkit-scrollbar-thumb {
  background: var(--sai-gray-200);
  border-radius: 10px;
}

/* Message Bubble */
.shop-ai-message {
  max-width: 85%;
  animation: messageSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes messageSlideIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.shop-ai-message.user {
  align-self: flex-end;
}

.shop-ai-message.assistant {
  align-self: flex-start;
}

.shop-ai-message-content {
  padding: 14px 18px;
  border-radius: var(--sai-radius-lg);
  font-size: 15px;
  line-height: 1.6;
  color: var(--sai-gray-900);
}

.shop-ai-message.user .shop-ai-message-content {
  background: var(--sai-gradient);
  color: white;
  border-bottom-right-radius: 4px;
}

.shop-ai-message.assistant .shop-ai-message-content {
  background: var(--sai-gray-100);
  border-bottom-left-radius: 4px;
}

/* ===== THINKING STATES (3 STAGES) ===== */
.shop-ai-thinking {
  align-self: flex-start;
  max-width: 85%;
}

.shop-ai-thinking-content {
  background: var(--sai-gray-100);
  padding: 14px 18px;
  border-radius: var(--sai-radius-lg);
  border-bottom-left-radius: 4px;
}

.shop-ai-thinking-stage {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  color: var(--sai-gray-600);
  margin-bottom: 8px;
  opacity: 0;
  animation: stageFadeIn 0.4s ease forwards;
}

.shop-ai-thinking-stage:last-child {
  margin-bottom: 0;
}

.shop-ai-thinking-stage.complete {
  opacity: 0.5;
}

.shop-ai-thinking-stage.active {
  opacity: 1;
  color: var(--sai-gray-900);
}

@keyframes stageFadeIn {
  to {
    opacity: 1;
  }
}

/* Animated Dots */
.shop-ai-dots {
  display: inline-flex;
  gap: 3px;
}

.shop-ai-dots span {
  width: 4px;
  height: 4px;
  background: currentColor;
  border-radius: 50%;
  animation: dotPulse 1.4s ease-in-out infinite;
}

.shop-ai-dots span:nth-child(2) {
  animation-delay: 0.2s;
}

.shop-ai-dots span:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dotPulse {
  0%, 60%, 100% {
    opacity: 0.3;
    transform: scale(0.8);
  }
  30% {
    opacity: 1;
    transform: scale(1.2);
  }
}

/* Shimmer Bar */
.shop-ai-shimmer-bar {
  width: 100%;
  height: 3px;
  background: var(--sai-gray-200);
  border-radius: 2px;
  overflow: hidden;
  margin-top: 12px;
}

.shop-ai-shimmer-bar::after {
  content: '';
  display: block;
  width: 40%;
  height: 100%;
  background: var(--sai-primary);
  animation: shimmerMove 1.5s ease-in-out infinite;
}

@keyframes shimmerMove {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(350%);
  }
}

/* ===== PRODUCT CAROUSEL ===== */
.shop-ai-product-section {
  margin: 16px 0;
}

.shop-ai-product-header {
  font-size: 16px;
  font-weight: 600;
  color: var(--sai-gray-900);
  margin-bottom: 8px;
}

.shop-ai-product-subtitle {
  font-size: 13px;
  color: var(--sai-gray-600);
  margin-bottom: 16px;
}

.shop-ai-product-carousel {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 8px;
  scrollbar-width: thin;
  scrollbar-color: var(--sai-gray-200) transparent;
}

.shop-ai-product-carousel::-webkit-scrollbar {
  height: 6px;
}

.shop-ai-product-carousel::-webkit-scrollbar-track {
  background: transparent;
}

.shop-ai-product-carousel::-webkit-scrollbar-thumb {
  background: var(--sai-gray-200);
  border-radius: 10px;
}

.shop-ai-product-card {
  flex-shrink: 0;
  width: 180px;
  background: white;
  border: 1px solid var(--sai-gray-200);
  border-radius: var(--sai-radius-lg);
  overflow: hidden;
  transition: all 0.2s ease;
  cursor: pointer;
}

.shop-ai-product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  border-color: var(--sai-primary);
}

.shop-ai-product-image {
  width: 100%;
  height: 180px;
  object-fit: cover;
  background: var(--sai-gray-50);
}

.shop-ai-product-info {
  padding: 12px;
}

.shop-ai-product-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--sai-gray-900);
  margin-bottom: 6px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 40px;
}

.shop-ai-product-price {
  font-size: 15px;
  font-weight: 700;
  color: var(--sai-primary);
}

/* ===== READ MORE ===== */
.shop-ai-read-more {
  display: inline-block;
  margin-top: 8px;
  color: var(--sai-primary);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: border-color 0.2s;
}

.shop-ai-read-more:hover {
  border-bottom-color: var(--sai-primary);
}

.shop-ai-expanded-content {
  display: none;
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid var(--sai-gray-200);
  animation: fadeIn 0.3s ease;
}

.shop-ai-expanded-content.visible {
  display: block;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* ===== SUGGESTIONS ===== */
.shop-ai-suggestions {
  padding: 20px 0;
}

.shop-ai-suggestions-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--sai-gray-600);
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.shop-ai-suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 20px;
}

.shop-ai-suggestion-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  background: white;
  border: 1px solid var(--sai-gray-200);
  border-radius: var(--sai-radius-lg);
  cursor: pointer;
  transition: all 0.2s ease;
  font-size: 14px;
  color: var(--sai-gray-900);
}

.shop-ai-suggestion-item:hover {
  border-color: var(--sai-primary);
  background: var(--sai-gray-50);
  transform: translateX(4px);
}

.shop-ai-suggestion-item svg {
  color: var(--sai-gray-400);
  flex-shrink: 0;
}

.shop-ai-quick-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.shop-ai-quick-action {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  background: white;
  border: 1px solid var(--sai-gray-200);
  border-radius: var(--sai-radius-full);
  font-size: 13px;
  font-weight: 500;
  color: var(--sai-gray-900);
  cursor: pointer;
  transition: all 0.2s ease;
}

.shop-ai-quick-action:hover {
  border-color: var(--sai-primary);
  color: var(--sai-primary);
  background: rgba(139, 127, 216, 0.05);
}

.shop-ai-quick-action svg {
  width: 16px;
  height: 16px;
}

/* ===== INPUT ===== */
.shop-ai-input-container {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 20px;
  border-top: 1px solid var(--sai-gray-200);
  background: white;
  flex-shrink: 0;
}

.shop-ai-back-btn {
  background: none;
  border: none;
  padding: 8px;
  color: var(--sai-gray-600);
  cursor: pointer;
  border-radius: 50%;
  transition: all 0.2s;
  flex-shrink: 0;
}

.shop-ai-back-btn:hover {
  background: var(--sai-gray-100);
  color: var(--sai-gray-900);
}

#shop-ai-input {
  flex: 1;
  border: none;
  background: var(--sai-gray-50);
  padding: 12px 16px;
  border-radius: var(--sai-radius-full);
  font-size: 15px;
  color: var(--sai-gray-900);
  outline: none;
  transition: background 0.2s;
}

#shop-ai-input:focus {
  background: var(--sai-gray-100);
}

#shop-ai-input::placeholder {
  color: var(--sai-gray-400);
}

.shop-ai-voice-btn {
  background: none;
  border: none;
  padding: 8px;
  color: var(--sai-primary);
  cursor: pointer;
  border-radius: 50%;
  transition: all 0.2s;
  flex-shrink: 0;
}

.shop-ai-voice-btn:hover {
  background: rgba(139, 127, 216, 0.1);
}

/* ===== ACCESSIBILITY ===== */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ===== MOBILE RESPONSIVE ===== */
@media (max-width: 768px) {
  .shop-ai-modal {
    width: 100%;
    height: 100%;
    max-height: 100%;
    border-radius: 0;
    top: 0;
    left: 0;
    transform: translateY(100%);
  }

  .shop-ai-modal.active {
    transform: translateY(0);
  }

  .shop-ai-fab-container {
    bottom: 20px;
    right: 20px;
  }

  .shop-ai-fab-secondary span,
  .shop-ai-fab-primary span {
    display: none;
  }

  .shop-ai-fab-secondary,
  .shop-ai-fab-primary {
    width: 56px;
    height: 56px;
    padding: 0;
    justify-content: center;
  }

  .shop-ai-product-card {
    width: 160px;
  }
}
</style>

<script>
(function() {
  'use strict';

  // Configuration
  const CONFIG = {
    apiUrl: '{{ api_url }}',
    thinkingStages: [
      { text: 'Thought about the question', duration: 800 },
      { text: 'Scouted for {query}', duration: 1000 },
      { text: 'Thinking', duration: 800 }
    ],
    maxResponseLength: 150, // Characters before "Read more"
    animations: {
      stageDelay: 100,
      messageReveal: 300
    }
  };

  // State
  const state = {
    isOpen: false,
    isLoading: false,
    messages: [],
    currentQuery: ''
  };

  // DOM Elements
  const elements = {
    wrapper: document.getElementById('shop-ai-wrapper'),
    backdrop: document.getElementById('shop-ai-backdrop'),
    fabContainer: document.getElementById('shop-ai-fab-container'),
    modal: document.getElementById('shop-ai-modal'),
    messages: document.getElementById('shop-ai-messages'),
    input: document.getElementById('shop-ai-input')
  };

  // Initialize
  function init() {
    showSuggestions();
  }

  // Public API
  window.ShopAIChat = {
    open,
    close,
    send,
    showSuggestions,
    handleSuggestion
  };

  // Open modal
  function open() {
    state.isOpen = true;
    elements.backdrop.classList.add('active');
    elements.modal.classList.add('active');
    elements.fabContainer.classList.add('hidden');
    setTimeout(() => elements.input.focus(), 400);
  }

  // Close modal
  function close() {
    state.isOpen = false;
    elements.backdrop.classList.remove('active');
    elements.modal.classList.remove('active');
    elements.fabContainer.classList.remove('hidden');
  }

  // Show suggestions panel
  function showSuggestions() {
    const html = `
      <div class="shop-ai-suggestions">
        <div class="shop-ai-suggestions-title">Suggestions</div>
        <div class="shop-ai-suggestion-list">
          <div class="shop-ai-suggestion-item" onclick="ShopAIChat.handleSuggestion('What snowboards are currently in stock')">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <span>What snowboards are currently in stock</span>
          </div>
          <div class="shop-ai-suggestion-item" onclick="ShopAIChat.handleSuggestion('Where can I find information on privacy')">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 3h6l3 3h9v13H3z"/>
            </svg>
            <span>Where can I find information on privacy</span>
          </div>
          <div class="shop-ai-suggestion-item" onclick="ShopAIChat.handleSuggestion('Show me snowboards for videography')">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <span>Show me snowboards for videography</span>
          </div>
        </div>

        <div class="shop-ai-suggestions-title">Quick Actions</div>
        <div class="shop-ai-quick-actions">
          <div class="shop-ai-quick-action" onclick="ShopAIChat.handleSuggestion('Help me choose')">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L13.5 8.5L20 10L13.5 11.5L12 18L10.5 11.5L4 10L10.5 8.5L12 2Z"/>
            </svg>
            <span>Help me choose</span>
          </div>
          <div class="shop-ai-quick-action" onclick="ShopAIChat.handleSuggestion('Track my order')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="1" y="3" width="15" height="13"/><path d="M16 8h5l3 3v5h-2"/>
              <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
            <span>Track my order</span>
          </div>
          <div class="shop-ai-quick-action" onclick="ShopAIChat.handleSuggestion('Previous chats')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
            </svg>
            <span>Previous chats</span>
          </div>
        </div>
      </div>
    `;
    elements.messages.innerHTML = html;
  }

  // Handle suggestion click
  function handleSuggestion(text) {
    elements.input.value = text;
    send();
  }

  // Send message
  async function send() {
    const text = elements.input.value.trim();
    if (!text || state.isLoading) return;

    state.currentQuery = text;
    elements.input.value = '';
    state.isLoading = true;

    // Add user message
    addUserMessage(text);

    // Show staged thinking animation
    await showThinkingAnimation(text);

    // Make API call
    try {
      const response = await makeAPICall(text);
      removeThinking();
      handleResponse(response);
    } catch (error) {
      console.error('Chat error:', error);
      removeThinking();
      addAssistantMessage('Sorry, I encountered an error. Please try again.');
    } finally {
      state.isLoading = false;
    }
  }

  // Add user message
  function addUserMessage(text) {
    const html = `
      <div class="shop-ai-message user">
        <div class="shop-ai-message-content">${escapeHtml(text)}</div>
      </div>
    `;
    elements.messages.insertAdjacentHTML('beforeend', html);
    scrollToBottom();
  }

  // Show thinking animation with 3 stages
  async function showThinkingAnimation(query) {
    const thinkingHtml = `
      <div class="shop-ai-thinking" id="shop-ai-thinking">
        <div class="shop-ai-thinking-content">
          <div class="shop-ai-thinking-stage" data-stage="0">
            <span>${CONFIG.thinkingStages[0].text}</span>
          </div>
          <div class="shop-ai-thinking-stage" data-stage="1">
            <span>${CONFIG.thinkingStages[1].text.replace('{query}', extractKeyword(query))}</span>
          </div>
          <div class="shop-ai-thinking-stage" data-stage="2">
            <span>${CONFIG.thinkingStages[2].text}</span>
            <div class="shop-ai-dots">
              <span></span><span></span><span></span>
            </div>
          </div>
          <div class="shop-ai-shimmer-bar"></div>
        </div>
      </div>
    `;
    elements.messages.insertAdjacentHTML('beforeend', thinkingHtml);
    scrollToBottom();

    // Animate stages sequentially
    const stages = document.querySelectorAll('.shop-ai-thinking-stage');
    for (let i = 0; i < stages.length; i++) {
      await delay(CONFIG.animations.stageDelay);
      stages[i].classList.add('active');
      if (i > 0) stages[i - 1].classList.add('complete');
      await delay(CONFIG.thinkingStages[i].duration);
    }
  }

  // Remove thinking indicator
  function removeThinking() {
    const thinking = document.getElementById('shop-ai-thinking');
    if (thinking) {
      thinking.style.opacity = '0';
      setTimeout(() => thinking.remove(), 200);
    }
  }

  // Handle API response
  function handleResponse(data) {
    if (data.message) {
      const { short, full } = truncateResponse(data.message);
      const needsReadMore = short !== full;

      let html = `
        <div class="shop-ai-message assistant" style="opacity: 0;">
          <div class="shop-ai-message-content">
            <div class="shop-ai-main-content">${escapeHtml(short)}</div>
      `;

      if (needsReadMore) {
        html += `
            <a class="shop-ai-read-more" onclick="this.style.display='none'; this.nextElementSibling.classList.add('visible')">
              Read more
            </a>
            <div class="shop-ai-expanded-content">${escapeHtml(full)}</div>
        `;
      }

      html += `</div></div>`;
      
      elements.messages.insertAdjacentHTML('beforeend', html);
      
      // Fade in
      const lastMessage = elements.messages.lastElementChild;
      setTimeout(() => {
        lastMessage.style.transition = 'opacity 0.3s ease';
        lastMessage.style.opacity = '1';
      }, 50);
    }

    // Add products if present
    if (data.products && data.products.length > 0) {
      addProductCarousel(data.products);
    }

    // Add follow-up question
    if (data.followUp) {
      addFollowUpQuestion(data.followUp);
    }

    scrollToBottom();
  }

  // Add product carousel
  function addProductCarousel(products) {
    let html = `
      <div class="shop-ai-message assistant">
        <div class="shop-ai-product-section">
          <div class="shop-ai-product-header">Snowboards In Stock</div>
          <div class="shop-ai-product-subtitle">Discover our available snowboards</div>
          <div class="shop-ai-product-carousel">
    `;

    products.forEach(product => {
      html += `
        <div class="shop-ai-product-card" onclick="window.open('${product.url}', '_blank')">
          <img src="${product.image}" alt="${product.title}" class="shop-ai-product-image" loading="lazy">
          <div class="shop-ai-product-info">
            <div class="shop-ai-product-title">${escapeHtml(product.title)}</div>
            <div class="shop-ai-product-price">${product.price}</div>
          </div>
        </div>
      `;
    });

    html += `
          </div>
        </div>
      </div>
    `;

    elements.messages.insertAdjacentHTML('beforeend', html);
  }

  // Add follow-up question
  function addFollowUpQuestion(question) {
    const html = `
      <div class="shop-ai-message assistant">
        <div class="shop-ai-message-content">${escapeHtml(question)}</div>
      </div>
    `;
    elements.messages.insertAdjacentHTML('beforeend', html);
  }

  // Add assistant message
  function addAssistantMessage(text) {
    const html = `
      <div class="shop-ai-message assistant">
        <div class="shop-ai-message-content">${escapeHtml(text)}</div>
      </div>
    `;
    elements.messages.insertAdjacentHTML('beforeend', html);
    scrollToBottom();
  }

  // Make API call (replace with real implementation)
  async function makeAPICall(query) {
    await delay(500); // Simulate network delay

    // Mock response
    return {
      message: 'We have several fantastic snowboards currently in stock! Our collection includes models for all skill levels, from beginners to advanced riders. Each board features premium construction and modern technology to enhance your riding experience.',
      products: [
        {
          title: 'The Complete Snowboard',
          price: '$699.95',
          image: 'https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png',
          url: '/products/complete-snowboard'
        },
        {
          title: 'The Inventory Not Tracked Snowboard',
          price: '$949.95',
          image: 'https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png',
          url: '/products/inventory-snowboard'
        },
        {
          title: 'The Hidden Snowboard',
          price: '$749.95',
          image: 'https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png',
          url: '/products/hidden-snowboard'
        }
      ],
      followUp: 'Is there a particular style or feature you\'re looking for in a snowboard?'
    };
  }

  // Truncate response for "Read more"
  function truncateResponse(text) {
    if (text.length <= CONFIG.maxResponseLength) {
      return { short: text, full: text };
    }

    let short = text.substring(0, CONFIG.maxResponseLength);
    const lastSpace = short.lastIndexOf(' ');
    if (lastSpace > 0) {
      short = short.substring(0, lastSpace);
    }
    short += '...';

    return { short, full: text };
  }

  // Extract keyword from query
  function extractKeyword(query) {
    const words = query.toLowerCase().split(' ');
    const keywords = ['snowboard', 'product', 'order', 'delivery', 'price', 'stock'];
    for (const word of words) {
      if (keywords.includes(word)) return word + 's';
    }
    return 'results';
  }

  // Utilities
  function scrollToBottom() {
    elements.messages.scrollTop = elements.messages.scrollHeight;
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  // Handle backdrop click
  elements.backdrop.addEventListener('click', close);

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

