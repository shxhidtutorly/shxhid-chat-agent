# ─── Anthropic (required) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Main chat model. Default: claude-sonnet-4-6 (QA-backed decision — see
# app/services/claude.server.js). Rollback lever without a deploy:
# CLAUDE_CHAT_MODEL=claude-haiku-4-5-20251001
#CLAUDE_CHAT_MODEL=claude-sonnet-4-6

# Query-rewriter model (single-shot, tiny output — Haiku is deliberate).
#CLAUDE_QUERYINTEL_MODEL=claude-haiku-4-5-20251001

# ─── Algolia (required for Tier-1 search; ALL THREE or none) ─────────────────
# If any of the three is missing, Tier 1 is disabled and every search falls
# back to the much weaker Admin/Storefront tiers (this is loudly logged).
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=
# Production index per docs/algolia-config.md:
ALGOLIA_INDEX_NAME=shopify_shxhidproducts

# ─── Shopify (required) ──────────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.up.railway.app
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
#SHOPIFY_API_VERSION=2025-01
#SCOPES=read_products,write_products
#SHOP_CUSTOM_DOMAIN=

# ─── Database (required; Railway PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/db

# ─── Diagnostics / observability (recommended) ───────────────────────────────
# Gates GET /api/diag (incl. the ?health=1 readiness check). Pick a long
# random string.
DIAG_TOKEN=

# PostHog analytics (optional — events are dropped silently when unset)
#POSTHOG_API_KEY=
#POSTHOG_HOST=https://us.i.posthog.com

# Verbose search-pipeline logging (Algolia ranked lists etc.)
#DEBUG_SEARCH=1

# Customer-account OAuth redirect (see app/auth.server.js)
#REDIRECT_URL=
