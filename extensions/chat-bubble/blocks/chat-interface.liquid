{% comment %}
  Shopify AI Chat Agent - FIXED UI/UX (No Emojis, Bottom Carousel, Clean Tables)
  Replacement file for chat-interface.liquid
{% endcomment %}

<div id="shop-ai-chat-wrapper">
  <div class="shop-ai-floating-group" id="shop-ai-floating-group">
    <button class="shop-ai-floating-btn secondary" onclick="ShopAIChat.toggleChat()">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
      <span>Chat</span>
    </button>
    <button class="shop-ai-floating-btn primary" onclick="ShopAIChat.toggleChat()">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
      <span>Ask AI Assistant</span>
    </button>
  </div>

  <div class="shop-ai-chat-container" id="shop-ai-chat-container">
    <div class="shop-ai-chat-header">
      <div class="shop-ai-header-title">
        <div class="shop-ai-avatar-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
        </div>
        <div>
          <h3>Shop Assistant</h3>
          <span class="shop-ai-status">Online</span>
        </div>
      </div>
      <div class="shop-ai-header-actions">
         <button class="shop-ai-icon-btn" onclick="ShopAIChat.toggleMenu()">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg>
        </button>
        <button class="shop-ai-icon-btn close-btn" onclick="ShopAIChat.toggleChat()">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
       <div class="shop-ai-dropdown" id="shop-ai-menu">
        <button onclick="ShopAIChat.clearChat()">Clear History</button>
      </div>
    </div>

    <div class="shop-ai-chat-messages" id="shop-ai-chat-messages">
      <div class="shop-ai-message assistant welcome-message">
         <div class="shop-ai-message-content">
           Hello! I'm your AI shopping assistant. I can help you find products, check availability, or answer questions about your order. How can I help you today?
         </div>
       </div>
    </div>

    <div class="shop-ai-status-bar">
      <span class="shop-ai-status-pill">Ready to help</span>
    </div>

    <div class="shop-ai-chat-input-area">
      <div class="shop-ai-input-wrapper">
        <textarea id="shop-ai-input" placeholder="Ask anything about our products..." rows="1" onkeydown="if(event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); ShopAIChat.sendMessage(); }"></textarea>
        <button class="shop-ai-send-btn" onclick="ShopAIChat.sendMessage()">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
/* --- Modern CSS Variables --- */
:root {
  --sai-primary: #2563eb; /* Vibrant Blue */
  --sai-primary-dark: #1e40af;
  --sai-accent-gradient: linear-gradient(135deg, #2563eb, #4f46e5);
  --sai-bg-chat: rgba(255, 255, 255, 0.95);
  --sai-bg-secondary: #f3f4f6;
  --sai-text-main: #111827;
  --sai-text-muted: #6b7280;
  --sai-border: #e5e7eb;
  --sai-shadow-lg: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  --sai-shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
  --sai-radius-xl: 20px;
  --sai-radius-lg: 16px;
  --sai-radius-md: 12px;
}

/* Dark Mode Preference support */
@media (prefers-color-scheme: dark) {
  :root {
    --sai-bg-chat: rgba(31, 41, 55, 0.95);
    --sai-bg-secondary: #374151;
    --sai-text-main: #f9fafb;
    --sai-text-muted: #9ca3af;
    --sai-border: #4b5563;
  }
}

/* --- Wrapper & Base --- */
#shop-ai-chat-wrapper {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  z-index: 999999;
  position: fixed;
  bottom: 20px;
  right: 20px;
  pointer-events: none; /* Allow clicks to pass through wrapper */
}

#shop-ai-chat-wrapper * {
  box-sizing: border-box;
  pointer-events: auto; /* Catch clicks on children */
}

/* --- Floating Buttons --- */
.shop-ai-floating-group {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10px;
  position: absolute;
  bottom: 0;
  right: 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Hide buttons when chat is active */
.shop-ai-floating-group.hidden {
  opacity: 0;
  transform: translateY(20px) scale(0.9);
  pointer-events: none;
}

.shop-ai-floating-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 20px;
  border-radius: 30px;
  border: none;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  box-shadow: var(--sai-shadow-lg);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.shop-ai-floating-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 15px 30px -5px rgba(0, 0, 0, 0.15);
}

.shop-ai-floating-btn.primary {
  background: var(--sai-accent-gradient);
  color: white;
}

.shop-ai-floating-btn.secondary {
  background: var(--sai-bg-chat);
  color: var(--sai-text-main);
  border: 1px solid var(--sai-border);
}

/* --- Main Chat Container --- */
.shop-ai-chat-container {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 380px;
  height: 600px;
  max-height: calc(100vh - 40px);
  background: var(--sai-bg-chat);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: var(--sai-radius-xl);
  box-shadow: var(--sai-shadow-lg);
  border: 1px solid var(--sai-border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  /* Hidden state */
  opacity: 0;
  transform: translateY(30px) scale(0.95);
  pointer-events: none;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.shop-ai-chat-container.active {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

/* --- Header --- */
.shop-ai-chat-header {
  padding: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--sai-border);
  background: rgba(255,255,255,0.5);
}

.shop-ai-header-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.shop-ai-avatar-icon {
  width: 36px;
  height: 36px;
  background: var(--sai-accent-gradient);
  color: white;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shop-ai-header-title h3 {
  margin: 0;
  font-size: 16px;
  font-weight: 700;
  color: var(--sai-text-main);
}

.shop-ai-status {
  font-size: 12px;
  color: #10b981; /* Green */
  display: flex;
  align-items: center;
}
.shop-ai-status::before {
  content: '';
  display: inline-block;
  width: 6px;
  height: 6px;
  background-color: #10b981;
  border-radius: 50%;
  margin-right: 5px;
}

.shop-ai-icon-btn {
  background: none;
  border: none;
  padding: 8px;
  color: var(--sai-text-muted);
  cursor: pointer;
  border-radius: 8px;
  transition: background 0.2s;
}
.shop-ai-icon-btn:hover { background: var(--sai-bg-secondary); color: var(--sai-text-main); }

/* --- Messages Area --- */
.shop-ai-chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  scroll-behavior: smooth;
}

.shop-ai-message {
  max-width: 85%;
  display: flex;
  flex-direction: column;
  animation: fade InUp 0.3s ease;
}

.shop-ai-message-content {
  padding: 12px 16px;
  border-radius: var(--sai-radius-lg);
  font-size: 15px;
  line-height: 1.5;
  position: relative;
  word-wrap: break-word;
}

/* Assistant Message Style */
.shop-ai-message.assistant {
  align-self: flex-start;
}
.shop-ai-message.assistant .shop-ai-message-content {
  background: var(--sai-bg-secondary);
  color: var(--sai-text-main);
  border-bottom-left-radius: 4px;
}

/* User Message Style */
.shop-ai-message.user {
  align-self: flex-end;
}
.shop-ai-message.user .shop-ai-message-content {
  background: var(--sai-accent-gradient);
  color: white;
  border-bottom-right-radius: 4px;
  box-shadow: var(--sai-shadow-sm);
}

/* --- FIX TASK 3: Table Formatting (Cleaned up borders) --- */
.shop-ai-message-content table {
  width: 100%;
  border-collapse: collapse; /* FIXED: Changed from separate to collapse */
  margin: 12px 0;
  font-size: 14px;
  /* FIXED: Removed outer border, let cells handle it */
  border: none;
  background: var(--sai-bg-chat);
}

.shop-ai-message-content th,
.shop-ai-message-content td {
  padding: 10px 12px;
  text-align: left;
  /* FIXED: Only bottom border for clean look */
  border-bottom: 1px solid var(--sai-border);
  color: var(--sai-text-main);
}

.shop-ai-message-content th {
  background: var(--sai-bg-secondary);
  font-weight: 600;
  color: var(--sai-text-muted);
  text-transform: uppercase;
  font-size: 12px;
  letter-spacing: 0.05em;
  /* FIXED: Ensure header has bottom border */
  border-bottom: 1px solid var(--sai-border);
}

.shop-ai-message-content tr:last-child td {
  border-bottom: none;
}

/* Important for mobile: allow horizontal scroll on tables */
.table-responsive {
  display: block;
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  margin-bottom: 10px;
  border: 1px solid var(--sai-border); /* Single outer border for the container */
  border-radius: var(--sai-radius-md);
}


/* --- FIX TASK 1: Shimmer Animation (Removed Emojis) --- */
.shop-ai-message.typing .shop-ai-message-content {
  padding: 12px 20px;
  background: var(--sai-bg-secondary);
  border-radius: var(--sai-radius-lg);
  border-bottom-left-radius: 4px;
  display: inline-block;
}

/* The magical shimmer gradient text effect - EMOJIS REMOVED */
.shop-ai-shimmer-text {
  font-weight: 600;
  font-size: 14px;
  background: linear-gradient(
    90deg,
    var(--sai-text-muted) 0%,
    var(--sai-text-main) 40%,
    var(--sai-text-muted) 80%
  );
  background-size: 200% auto;
  color: transparent;
  -webkit-background-clip: text;
  background-clip: text;
  animation: shimmerMove 2s linear infinite;
  position: relative;
  /* FIXED: Removed ::before and ::after pseudo-elements that held emojis */
}

@keyframes shimmerMove {
  to { background-position: 200% center; }
}

/* Updating Cart Spinner */
.shop-ai-updating-cart {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    color: var(--sai-text-muted);
    font-size: 14px;
    font-style: italic;
}
.shop-ai-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid var(--sai-border);
    border-top-color: var(--sai-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }


/* --- Status Footer (Centered) --- */
.shop-ai-status-bar {
  text-align: center;
  padding: 8px 0;
  background: var(--sai-bg-chat);
}
.shop-ai-status-pill {
  display: inline-block;
  padding: 4px 12px;
  background: var(--sai-bg-secondary);
  border-radius: 20px;
  font-size: 11px;
  color: var(--sai-text-muted);
  font-weight: 500;
}

/* --- Input Area --- */
.shop-ai-chat-input-area {
  padding: 16px;
  background: var(--sai-bg-chat);
  border-top: 1px solid var(--sai-border);
}

.shop-ai-input-wrapper {
  display: flex;
  align-items: flex-end;
  background: var(--sai-bg-secondary);
  border-radius: 24px;
  padding: 8px;
  border: 1px solid transparent;
  transition: all 0.2s;
}
.shop-ai-input-wrapper:focus-within {
    border-color: var(--sai-primary);
    background: var(--sai-bg-chat);
}

#shop-ai-input {
  flex: 1;
  background: transparent;
  border: none;
  resize: none;
  max-height: 100px;
  padding: 8px 12px;
  font-family: inherit;
  font-size: 15px;
  outline: none;
  color: var(--sai-text-main);
}

.shop-ai-send-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  background: var(--sai-accent-gradient);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform 0.2s;
  flex-shrink: 0;
}
.shop-ai-send-btn:hover { transform: scale(1.05); }
.shop-ai-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }


/* --- Menu Dropdown --- */
.shop-ai-dropdown {
    position: absolute;
    top: 60px;
    right: 16px;
    background: var(--sai-bg-chat);
    border: 1px solid var(--sai-border);
    border-radius: var(--sai-radius-md);
    box-shadow: var(--sai-shadow-lg);
    padding: 8px;
    display: none;
    z-index: 100;
}
.shop-ai-dropdown.active { display: block; animation: fadeIn 0.2s ease; }
.shop-ai-dropdown button {
    width: 100%;
    text-align: left;
    padding: 8px 12px;
    background: none;
    border: none;
    color: #ef4444; /* Red for clear action */
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
}
.shop-ai-dropdown button:hover { background: #fee2e2; }

/* --- Product Carousel CSS --- */
.shop-ai-carousel-container {
  margin: 12px 0 12px auto; /* Align right like user messages */
  width: 85%;
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 10px; /* Space for scrollbar */
  /* Hide scrollbar for cleaner look */
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none;  /* IE 10+ */
}
.shop-ai-carousel-container::-webkit-scrollbar {
    display: none; /* Chrome/Safari/Webkit */
}

.shop-ai-product-card {
  display: inline-block;
  width: 160px;
  margin-left: 12px;
  background: var(--sai-bg-chat);
  border: 1px solid var(--sai-border);
  border-radius: var(--sai-radius-md);
  overflow: hidden;
  vertical-align: top;
  transition: transform 0.2s;
  box-shadow: var(--sai-shadow-sm);
}
.shop-ai-product-card:first-child { margin-left: 0; }
.shop-ai-product-card:hover { transform: translateY(-3px); box-shadow: var(--sai-shadow-lg); }

.shop-ai-product-image {
  width: 100%;
  height: 140px;
  object-fit: cover;
  background: var(--sai-bg-secondary);
}

.shop-ai-product-info {
  padding: 10px;
  white-space: normal; /* Allow text wrap inside card */
}

.shop-ai-product-title {
  font-size: 13px;
  font-weight: 600;
  margin: 0 0 6px 0;
  color: var(--sai-text-main);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  height: 34px; /* Fixed height for 2 lines */
}

.shop-ai-product-price {
  font-size: 14px;
  color: var(--sai-text-muted);
  margin-bottom: 10px;
}

.shop-ai-add-to-cart-btn {
  width: 100%;
  padding: 8px;
  background: var(--sai-bg-secondary);
  color: var(--sai-text-main);
  border: none;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}
.shop-ai-add-to-cart-btn:hover {
  background: var(--sai-primary);
  color: white;
}

/* --- Animations & Mobile --- */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

@media (max-width: 480px) {
  .shop-ai-chat-container {
    width: 100vw;
    height: 100vh;
    max-height: none;
    bottom: 0;
    right: 0;
    border-radius: 0;
  }
  #shop-ai-chat-wrapper { bottom: 0; right: 0; }
  .shop-ai-floating-group { bottom: 20px; right: 20px; }
  .shop-ai-message { max-width: 90%; }
  .shop-ai-carousel-container { width: 95%; }
}
</style>

<script>
// Define the API endpoint - Replace with your actual worker URL
const SHOP_AI_API_URL = 'https://your-cloudflare-worker-url.workers.dev';

const ShopAIChat = (function() {
  // State
  let isOpen = false;
  let isMenuOpen = false;
  let isLoading = false;
  let chatHistory = [];

  // DOM Elements
  const elements = {
    container: document.getElementById('shop-ai-chat-container'),
    floatingGroup: document.getElementById('shop-ai-floating-group'), // Get the group
    messagesArea: document.getElementById('shop-ai-chat-messages'),
    input: document.getElementById('shop-ai-input'),
    sendBtn: document.querySelector('.shop-ai-send-btn'),
    menu: document.getElementById('shop-ai-menu')
  };

  // Initialization
  function init() {
    loadHistory();
    // Auto-resize textarea
    elements.input.addEventListener('input', function() {
      this.style.height = 'auto';
      this.style.height = (this.scrollHeight) + 'px';
    });
  }

  // --- Actions ---

  function toggleChat() {
    isOpen = !isOpen;
    // Toggle active class on container
    elements.container.classList.toggle('active', isOpen);
    // Toggle hidden class on floating buttons to make room
    elements.floatingGroup.classList.toggle('hidden', isOpen);

    if (isOpen) {
      setTimeout(() => elements.input.focus(), 300);
      scrollToBottom();
    }
  }

  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    elements.menu.classList.toggle('active', isMenuOpen);
  }

  async function sendMessage() {
    const text = elements.input.value.trim();
    if (!text || isLoading) return;

    // 1. Add User Message
    addMessageToUI(text, 'user');
    saveToHistory(text, 'user');
    elements.input.value = '';
    elements.input.style.height = 'auto';
    isLoading = true;
    updateSendBtnState();

    // 2. Show Shimmer (Thinking) Animation
    showTypingIndicator();
    scrollToBottom();

    try {
      // 3. Prepare Context data (Optional - keep if your backend uses it)
      const context = {
        cart: await getCartData(),
        // Note: Liquid objects won't work inside this .js file unless it's parsed by Shopify first.
        // If this file is served as static JS, remove the liquid lines below.
        // page: {
        //   template: '{{ template.name }}',
        //   product: {{ product | json }},
        //   collection: {{ collection.title | json }}
        // }
      };

      // 4. API Call (Replace with real call when ready)
      // const response = await fetch(SHOP_AI_API_URL, { ... });
      // const data = await response.json();

      // MOCK RESPONSE FOR TESTING THE UI FIXES
      const data = await mockApiResponse(text);


      // 5. Handle Response
      handleResponse(data);


    } catch (error) {
      console.error('Chat Error:', error);
      removeTypingIndicator();
      addMessageToUI("I'm having trouble connecting right now. Please try again.", 'assistant error');
    } finally {
      isLoading = false;
      updateSendBtnState();
      scrollToBottom();
    }
  }

  // --- FIX TASK 2: Reorder Response Output ---
  async function handleResponse(data) {
      removeTypingIndicator();

      // 1. Text reply FIRST
      if (data.reply) {
          addMessageToUI(data.reply, 'assistant');
          saveToHistory(data.reply, 'assistant');
      }

      // 2. Product Carousel SECOND (at the bottom)
      if (data.products && data.products.length > 0) {
          addProductCarouselToUI(data.products);
          // Note: We don't usually save complex carousels to simple localstorage history.
      }

      // Handle Operations (e.g., Add to cart)
      if (data.operation) {
          await handleOperation(data.operation);
      }
  }


  // --- UI Helpers ---

  function addMessageToUI(content, role) {
    const messageDiv = document.createElement('div');
    // role can be 'user', 'assistant', or 'assistant error'
    messageDiv.className = `shop-ai-message ${role}`;

    // Simple markdown-like parsing for tables if they aren't already HTML
    let formattedContent = content;
    if (!content.trim().startsWith('<')) {
        formattedContent = parseMarkdownTable(content);
         // Convert newlines to breaks if it's plain text and not a table
        if(formattedContent === content) {
             formattedContent = content.replace(/\n/g, '<br>');
        }
    }

    messageDiv.innerHTML = `
      <div class="shop-ai-message-content">
        ${formattedContent}
      </div>
    `;
    elements.messagesArea.appendChild(messageDiv);
  }

  function addProductCarouselToUI(products) {
      const carouselContainer = document.createElement('div');
      carouselContainer.className = 'shop-ai-carousel-container';

      products.forEach(prod => {
          const card = document.createElement('div');
          card.className = 'shop-ai-product-card';
          // Use a placeholder if image is missing, fallback to standard Shopify no-image
          const imgUrl = prod.image || '//cdn.shopify.com/s/assets/no-image-2048-5e88c1b20e087fb7bbe9a3771824e743c244f437e4f8ba93bbf7b11b53f7824c.gif';

          card.innerHTML = `
              <img src="${imgUrl}" alt="${prod.title}" class="shop-ai-product-image">
              <div class="shop-ai-product-info">
                  <h4 class="shop-ai-product-title">${prod.title}</h4>
                  <div class="shop-ai-product-price">${prod.price}</div>
                  <button class="shop-ai-add-to-cart-btn" onclick="ShopAIChat.handleCartAdd('${prod.variantId}')">Add to Cart</button>
              </div>
          `;
          carouselContainer.appendChild(card);
      });

      // Wrap in assistant message style for alignment
      const messageWrapper = document.createElement('div');
      messageWrapper.className = 'shop-ai-message assistant carousel-message';
      messageWrapper.style.maxWidth = '100%'; // Allow carousel to take full width
      messageWrapper.appendChild(carouselContainer);

      elements.messagesArea.appendChild(messageWrapper);
  }


  function showTypingIndicator() {
    const typingDiv = document.createElement('div');
    typingDiv.className = 'shop-ai-message assistant typing';
    typingDiv.id = 'shop-ai-typing-indicator';
    // No emojis here anymore, just the shimmer text class
    typingDiv.innerHTML = `
      <div class="shop-ai-message-content">
        <span class="shop-ai-shimmer-text">AI is thinking...</span>
      </div>
    `;
    elements.messagesArea.appendChild(typingDiv);
  }

  function removeTypingIndicator() {
    const indicator = document.getElementById('shop-ai-typing-indicator');
    if (indicator) indicator.remove();
  }

  function showUpdatingCartIndicator() {
      const indicator = document.createElement('div');
      indicator.id = 'shop-ai-cart-updating';
      indicator.className = 'shop-ai-updating-cart';
      indicator.innerHTML = '<div class="shop-ai-spinner"></div><span>Updating cart...</span>';
      elements.messagesArea.appendChild(indicator);
      scrollToBottom();
  }

  function removeUpdatingCartIndicator() {
      const indicator = document.getElementById('shop-ai-cart-updating');
      if (indicator) indicator.remove();
  }

  function scrollToBottom() {
    elements.messagesArea.scrollTop = elements.messagesArea.scrollHeight;
  }

  function updateSendBtnState() {
    elements.sendBtn.disabled = isLoading;
    elements.sendBtn.style.opacity = isLoading ? '0.5' : '1';
  }

  // --- Data & Operations ---

  async function getCartData() {
    try {
      const res = await fetch('/cart.js');
      return await res.json();
    } catch (e) { return null; }
  }

  // Public function to handle add to cart from carousel
  async function handleCartAdd(variantId) {
      if(!variantId) return;
      const item = { id: parseInt(variantId), quantity: 1 };
      await handleOperation({ type: 'add_to_cart', items: [item] });
  }


  async function handleOperation(op) {
      if (op.type === 'add_to_cart') {
          showUpdatingCartIndicator();
          try {
              // Shopify AJAX API endpoint for adding to cart
              await fetch('/cart/add.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ items: op.items })
              });
              // Refresh to show cart drawer or update cart count (Theme dependent)
              // document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true })); // Common Theme event
               window.location.reload(); // Fallback: Reload page
          } catch (err) {
             console.error(err);
             addMessageToUI("Sorry, I couldn't add that to the cart.", 'assistant error');
          } finally {
              removeUpdatingCartIndicator();
          }
      }
  }


  // --- History Management ---

  function saveToHistory(content, role) {
    // Don't save complex HTML replies to localstorage history for now, keep it simple
    if(content.includes('<div class="table-responsive">')) return;

    chatHistory.push({ role, content });
    localStorage.setItem('shopAiChatHistory', JSON.stringify(chatHistory));
  }

  function loadHistory() {
    const saved = localStorage.getItem('shopAiChatHistory');
    if (saved) {
      try {
        chatHistory = JSON.parse(saved);
        // Remove default welcome if history exists
        if(chatHistory.length > 0) {
            elements.messagesArea.innerHTML = '';
        }
        chatHistory.forEach(msg => addMessageToUI(msg.content, msg.role));
      } catch (e) {
        console.error('Could not load chat history', e);
        localStorage.removeItem('shopAiChatHistory');
      }
    }
  }

  function clearChat() {
    localStorage.removeItem('shopAiChatHistory');
    chatHistory = [];
    elements.messagesArea.innerHTML = `
       <div class="shop-ai-message assistant welcome-message">
         <div class="shop-ai-message-content">
           Chat history cleared. How can I help you now?
         </div>
       </div>`;
    toggleMenu();
  }

  // --- Utilities ---

  // Markdown table parser (adds table-responsive wrapper and clean HTML structure)
  function parseMarkdownTable(text) {
    if (!text.includes('|')) return text;
    const lines = text.trim().split('\n');
    if (lines.length < 3) return text;

    // FIX: Added class for outer border styling
    let html = '<div class="table-responsive"><table>';
    let inTable = false;
    let headerProcessed = false;

    lines.forEach((line, index) => {
        // Check if line looks like a table row
        if (line.trim().startsWith('|') && line.trim().endsWith('|')) {
            inTable = true;
            // Remove first and last | chars, then split
            const cells = line.trim().substring(1, line.trim().length - 1).split('|').map(c => c.trim());

            if (line.includes('---') && !headerProcessed) {
                // Separator line detected right after header candidate, ignore this line and mark header done
                headerProcessed = true;
            } else if (!headerProcessed) {
                // First line assumed header
                html += '<thead><tr>' + cells.map(c => `<th>${c}</th>`).join('') + '</tr></thead><tbody>';
            } else {
                 // Regular row
                html += '<tr>' + cells.map(c => `<td>${c}</td>`).join('') + '</tr>';
            }
        } else if (inTable) {
            inTable = false; // End of table block found
            html += '</tbody></table></div>' + line + '<br>';
        } else {
             html += line + '<br>';
        }
    });
    if (inTable) html += '</tbody></table></div>'; // Close if ended on a table row

    // If no actual table HTML was generated, return original text
    return html.includes('<tr>') ? html : text;
  }

  // UPDATED MOCK API FUNCTION FOR TESTING UI FIXES
  function mockApiResponse(text) {
      return new Promise(resolve => {
          setTimeout(() => {
              const lowerText = text.toLowerCase();

              // TEST CASE 1: Table Display (Testing Border Fix)
              if(lowerText.includes('table')) {
                   resolve({
                      reply: `Here is the comparison table you requested:
| Feature | Classic Model | Pro Model |
| :--- | :--- | :--- |
| Price | $99 | $149 |
| Material | Canvas | Leather |
| Warranty | 1 Year | 3 Years |
| Rating | 4.5/5 | 4.9/5 |
Check out the details below.`
                  });

              // TEST CASE 2: Product Carousel (Testing Position Fix - Should appear AFTER text)
              } else if (lowerText.includes('product') || lowerText.includes('show')) {
                   resolve({
                      // Text comes first in the object
                      reply: "I found these matching products for you. Take a look below:",
                      // Products array comes second
                      products: [
                          { title: "Classic Leather Sneaker - White", price: "$120.00", image: "https://cdn.shopify.com/s/files/1/0000/0001/products/shoe1.jpg?v=1600000000", variantId: "12345" },
                          { title: "Sport Runner - Blue/Black", price: "$95.00", image: "https://cdn.shopify.com/s/files/1/0000/0001/products/shoe2.jpg?v=1600000001", variantId: "67890" },
                           { title: "Casual Loafer - Brown Suede", price: "$110.00", image: "", variantId: "11223" }
                      ]
                  });

              // TEST CASE 3: Add to cart simulation
              } else if (lowerText.includes('add')) {
                   resolve({
                      reply: "I'm adding a demo item to your cart now.",
                      operation: {
                          type: 'add_to_cart',
                          // Use a dummy ID for testing UI, won't work without real Shopify variant ID
                          items: [{ id: 123456789, quantity: 1 }]
                      }
                  });
              }
              // Default response
              else {
                  resolve({ reply: "I can show you products or comparison tables. Try asking 'show me products' or 'show me a table'." });
              }
          }, 2000);
      });
  }


  // Initialize on load
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();

  // Expose Public Methods
  return { toggleChat, toggleMenu, sendMessage, clearChat, handleCartAdd };

})();
</script>

